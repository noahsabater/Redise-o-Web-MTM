---
// Productos del catálogo que menciona el artículo.
//
// Es la pieza que une el blog con las fichas: el blog trae el tráfico de Google
// y las fichas son las que convierten, pero hasta ahora no había puente entre
// los dos. Si el artículo no habla de ningún producto reconocible no se pinta
// nada — antes ningún producto que uno irrelevante.
import { productosDe } from '../../lib/productos-relacionados';

interface Props {
  /** Texto sobre el que buscar: título y cuerpo del artículo. */
  texto: string;
  limite?: number;
}

const { texto, limite = 4 } = Astro.props;
const items = productosDe(texto, limite);
---

{items.length > 0 && (
  <section class="pdel section">
    <div class="container-mtm">
      <div class="pdel-head">
        <span class="label label--tick">Del catálogo</span>
        <h2 class="pdel-title">Productos de los que habla este artículo</h2>
      </div>

      <div class="pdel-grid">
        {items.map((p) => (
          <a class="pdel-card" href={`/producto/${p.slug}/`}>
            <div class="pdel-media">
              {p.image ? (
                <img src={p.image} alt={p.imageAlt ?? p.name} loading="lazy" class="pdel-img" />
              ) : (
                <span class="pdel-noimg">{p.brandName}</span>
              )}
            </div>
            <div class="pdel-body">
              <span class="pdel-brand">{p.brandName}</span>
              <h3 class="pdel-name">{p.name}</h3>
              {p.gamaMain && <span class="pdel-gama">{p.gamaMain}</span>}
            </div>
          </a>
        ))}
      </div>

      <a class="pdel-todos" href="/productos/">Ver todo el catálogo →</a>
    </div>
  </section>
)}

<style>
  .pdel { background: var(--color-surface); }
  .pdel-head { margin-bottom: 2rem; }
  .pdel-title { font-size: clamp(1.5rem, 2.6vw, 2.1rem); line-height: 1.15; margin-top: 0.6rem; }

  .pdel-grid {
    display: grid; gap: 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  }
  .pdel-card {
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 14px;
    transition: transform 0.25s var(--ease-soft), box-shadow 0.25s var(--ease-soft);
  }
  .pdel-card:hover { transform: translateY(-3px); box-shadow: 0 16px 34px -22px rgba(0, 0, 0, 0.45); }
  .pdel-media {
    aspect-ratio: 4 / 3; display: grid; place-items: center; overflow: hidden;
    background: var(--color-surface);
  }
  .pdel-img { width: 100%; height: 100%; object-fit: cover; }
  .pdel-noimg { font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ash); }
  .pdel-body { padding: 0.95rem 1.05rem 1.2rem; display: flex; flex-direction: column; gap: 0.32rem; flex: 1; }
  .pdel-brand { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ash); }
  .pdel-name { font-size: 1.02rem; line-height: 1.25; color: var(--color-ink); }
  .pdel-gama { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-slate); margin-top: auto; }

  .pdel-todos {
    display: inline-block; margin-top: 1.6rem;
    font-size: 0.86rem; letter-spacing: 0.06em; color: var(--color-ink);
    border-bottom: 1px solid var(--color-line); padding-bottom: 0.2rem;
  }
  .pdel-todos:hover { border-color: var(--color-ink); }
</style>
