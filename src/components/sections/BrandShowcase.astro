---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Brand } from '../../data/brands';

interface Props {
  brand: Brand;
  hero: ImageMetadata;
  gallery?: ImageMetadata;
  origin?: string; // p.ej. "Marca francesa"
}
const { brand, hero, gallery, origin } = Astro.props;
---

<section class="bh">
  <div class="bh-media">
    <Image src={hero} alt={brand.name} widths={[900, 1440, 1920]} sizes="100vw" loading="eager" class="bh-img" />
    <div class="bh-scrim"></div>
  </div>
  <div class="container-mtm bh-inner">
    <span class="label label--tick on-dark">{origin ?? 'Marca'} · {brand.role}</span>
    <h1 class="bh-title">{brand.name}</h1>
    <p class="bh-tag">{brand.tagline}</p>
  </div>
</section>

<section class="section">
  <div class="container-mtm intro-grid">
    <p class="intro-lead reveal">{brand.description}</p>
    {brand.features && (
      <ul class="feat reveal" style="--reveal-delay: 120ms">
        {brand.features.map((f) => (
          <li class="feat-li">{f}</li>
        ))}
      </ul>
    )}
  </div>
</section>

<section class="section cat-sec">
  <div class="container-mtm">
    <div class="cat-head reveal">
      <span class="label label--tick">Gamas</span>
      <h2 class="cat-h">Explora el universo {brand.name}</h2>
    </div>
    <ul class="cat-list">
      {brand.categories.map((c, i) => (
        <li class="catrow reveal" style={`--reveal-delay: ${i * 50}ms`}>
          <span class="catrow-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="catrow-name">{c}</span>
          <a class="catrow-link" href={`/productos/${brand.slug}`} aria-label={`Ver productos de ${c}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

{gallery && (
  <section class="bh-gallery">
    <Image src={gallery} alt={`Aplicación de ${brand.name}`} widths={[900, 1440, 1920]} sizes="100vw" class="bh-gallery-img" />
  </section>
)}

<section class="brand-cta">
  <div class="container-mtm brand-cta-inner reveal">
    <h2 class="brand-cta-h">¿Listo para trabajar con {brand.name}?</h2>
    <div class="brand-cta-btns">
      <a class="btn btn--light" href="/aplicaciones">Ver aplicaciones
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a class="btn btn--ghost" href="/contacto">Hablar con MTM</a>
    </div>
  </div>
</section>

<style>
  .bh { position: relative; min-height: clamp(420px, 62vh, 640px); display: flex; align-items: flex-end; overflow: hidden; background: var(--color-carbon); }
  .bh-media { position: absolute; inset: 0; }
  .bh-img { width: 100%; height: 100%; object-fit: cover; }
  .bh-scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(11,11,10,0.7), rgba(11,11,10,0.15) 55%, rgba(11,11,10,0.35)); }
  .bh-inner { position: relative; z-index: 2; padding-block: clamp(2.5rem, 5vw, 4rem); color: var(--color-paper); }
  .bh-title { color: var(--color-paper); font-size: var(--text-hero); line-height: 1; margin: 1.2rem 0 1rem; }
  .bh-tag { color: rgba(244,244,242,0.85); max-width: 48ch; font-size: clamp(1.15rem, 1.5vw, 1.38rem); line-height: 1.55; }

  .intro-grid { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
  .intro-lead { font-size: clamp(1.2rem, 2.2vw, 1.7rem); line-height: 1.5; max-width: 40ch; }
  .feat { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .feat-li { padding: 0.9rem 0; border-top: 1px solid var(--color-line); font-size: 1.092rem; color: var(--color-slate); }
  .feat-li:last-child { border-bottom: 1px solid var(--color-line); }

  .cat-sec { background: var(--color-mist); }
  .cat-head { display: flex; flex-direction: column; gap: 1rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .cat-h { font-size: var(--text-display); line-height: var(--text-display--line-height); }
  .cat-list { list-style: none; margin: 0; padding: 0; }
  .catrow { display: grid; grid-template-columns: 3rem 1fr auto; align-items: center; gap: 1.5rem; padding: clamp(1.1rem, 2.2vw, 1.6rem) 0; border-top: 1px solid var(--color-line); transition: padding-left 0.4s var(--ease-soft); }
  .cat-list .catrow:last-child { border-bottom: 1px solid var(--color-line); }
  .catrow:hover { padding-left: 0.8rem; }
  .catrow-n { font-size: 0.828rem; letter-spacing: 0.16em; color: var(--color-ash); }
  .catrow-name { font-size: clamp(1.2rem, 2.4vw, 1.8rem); }
  .catrow-link { color: var(--color-ink); }
  .catrow-link svg { width: 20px; height: 20px; transition: transform 0.4s var(--ease-soft); }
  .catrow:hover .catrow-link svg { transform: translateX(6px); }

  .bh-gallery { line-height: 0; }
  .bh-gallery-img { width: 100%; height: clamp(320px, 50vw, 620px); object-fit: cover; }

  .brand-cta { background: var(--color-ink); color: var(--color-paper); padding-block: clamp(4rem, 9vw, 7rem); }
  .brand-cta-inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 2rem; }
  .brand-cta-h { color: var(--color-paper); font-size: var(--text-display); line-height: var(--text-display--line-height); max-width: 18ch; }
  .brand-cta-btns { display: flex; flex-wrap: wrap; gap: 1rem; }

  @media (max-width: 880px) {
    .intro-grid { grid-template-columns: 1fr; }
  }
</style>
