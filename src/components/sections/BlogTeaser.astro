---
import { Image } from 'astro:assets';
import { featuredPosts } from '../../data/posts';
---

<section class="bt section">
  <div class="container-mtm">
    <div class="bt-head reveal">
      <div>
        <span class="label label--tick">Diario</span>
        <h2 class="bt-title">Ideas para tus proyectos</h2>
        <p class="bt-sub">
          Consejos prácticos y tendencias de decoración y reformas para ayudarte a crear
          espacios con personalidad.
        </p>
      </div>
      <a class="btn btn--ghost-ink" href="/blog">Ir al blog</a>
    </div>

    <div class="bt-grid">
      {featuredPosts.map((post, i) => (
        <a class="bt-card reveal" href={post.href} style={`--reveal-delay: ${i * 90}ms`}>
          <div class="bt-media">
            <Image src={post.image} alt={post.title} widths={[420, 720]} sizes="(max-width: 880px) 100vw, 32vw" class="bt-img" />
          </div>
          <div class="bt-body">
            <div class="bt-meta">
              <span class="bt-cat">{post.category}</span>
              <span class="bt-date">{post.date}</span>
            </div>
            <h3 class="bt-h3">{post.title}</h3>
            <p class="bt-ex">{post.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .bt-head {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end;
    gap: 1.5rem; margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .bt-title { font-size: var(--text-display); line-height: var(--text-display--line-height); margin: 1.1rem 0 1rem; }
  .bt-sub { color: var(--color-slate); max-width: 46ch; font-size: 1.173rem; }

  .bt-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.4rem, 2.4vw, 2rem); }

  /* Misma estética que las tarjetas de la página de blog */
  .bt-card {
    display: flex; flex-direction: column;
    background: var(--color-surface); border: 1px solid var(--color-line);
    transition: box-shadow 0.5s var(--ease-soft), transform 0.5s var(--ease-soft), border-color 0.5s var(--ease-soft);
  }
  .bt-card:hover { transform: translateY(-4px); border-color: var(--color-ash); box-shadow: 0 20px 44px -28px rgba(11, 11, 10, 0.4); }
  .bt-media { overflow: hidden; aspect-ratio: 3 / 2; }
  .bt-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.8s var(--ease-soft); }
  .bt-card:hover .bt-img { transform: scale(1.05); }

  .bt-body { padding: 1.3rem 1.3rem 1.5rem; display: flex; flex-direction: column; }
  .bt-meta { display: flex; gap: 0.8rem; align-items: center; margin-bottom: 0.9rem; }
  .bt-cat {
    font-size: 0.736rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink);
    border: 1px solid var(--color-line); padding: 0.32rem 0.7rem; border-radius: 999px;
  }
  .bt-date { font-size: 0.851rem; color: var(--color-ash); }
  .bt-h3 { font-size: 1.334rem; line-height: 1.22; margin-bottom: 0.6rem; }
  .bt-ex { font-size: 1.035rem; color: var(--color-slate); line-height: 1.55; }

  @media (max-width: 880px) { .bt-grid { grid-template-columns: 1fr; gap: 1.4rem; } }
</style>
