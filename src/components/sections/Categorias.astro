---
import { Image } from 'astro:assets';
import m1 from '../../assets/categorias/cat-revestimientos.png';
import m2 from '../../assets/categorias/cat-tixol-nature.png';
import m3 from '../../assets/categorias/cat-soluciones.png';
import m4 from '../../assets/categorias/cat-interiores.png';

// Rejilla uniforme: 4 tarjetas del mismo tamaño (retrato), con el texto
// superpuesto en un panel de cristal sobre cada imagen.
const cats = [
  {
    n: '01',
    name: 'Revestimientos Naturales',
    desc: 'Texturas honestas de cal, arcilla y microcemento para paredes y suelos continuos.',
    image: m1,
    href: '/productos/tixol/nature',
  },
  {
    n: '02',
    name: 'Tixol Nature',
    desc: 'Pinturas y morteros de cal natural: acabados sanos, transpirables y atemporales.',
    image: m2,
    href: '/tixol',
  },
  {
    n: '03',
    name: 'Soluciones',
    desc: 'Resuelven problemas concretos: humedades, impermeabilización y más.',
    image: m3,
    href: '/productos/tixol/soluciones',
  },
  {
    n: '04',
    name: 'Interiores',
    desc: 'Sistemas decorativos para interiores con carácter: del pavimento a la pared.',
    image: m4,
    href: '/aplicaciones',
  },
];
---

<section class="cats">
  <div class="container-mtm">
    <div class="cats-head reveal">
      <span class="label label--tick">Colecciones</span>
      <h2 class="cats-title">Materiales que marcan la diferencia</h2>
    </div>

    <div class="cats-grid">
      {cats.map((c, i) => (
        <a class="cat reveal" href={c.href} style={`--reveal-delay: ${i * 90}ms`}>
          <Image src={c.image} alt={c.name} widths={[600, 1000, 1400]} sizes="(max-width: 620px) 100vw, 50vw" quality={88} class="cat-img" />
          <span class="cat-n">N.º {c.n}</span>
          <div class="cat-scrim"></div>
          <div class="cat-glass">
            <h3 class="cat-name">{c.name}</h3>
            <p class="cat-desc">{c.desc}</p>
            <span class="cat-link">
              Ver colección
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .cats {
    background: var(--color-carbon);
    color: var(--color-paper);
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }
  .cats-head {
    display: flex; flex-direction: column; gap: 1.2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .cats-head :global(.label) { color: rgba(244, 244, 242, 0.72); }
  .cats-title {
    color: var(--color-paper);
    font-size: var(--text-display); line-height: var(--text-display--line-height);
    max-width: 20ch;
  }

  .cats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.2rem, 2vw, 2rem);
  }
  .cat { min-width: 0; }

  /* Tarjeta uniforme en cuadrícula 2×2 */
  .cat {
    position: relative;
    aspect-ratio: 16 / 11;
    border-radius: 18px;
    overflow: hidden;
    display: block;
    background: #14130f;
    box-shadow: 0 20px 44px -28px rgba(0, 0, 0, 0.8);
    transition: transform 0.5s var(--ease-soft), box-shadow 0.5s var(--ease-soft);
  }
  .cat:hover { transform: translateY(-6px); box-shadow: 0 40px 70px -32px rgba(0, 0, 0, 0.9); }
  .cat-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 1.1s var(--ease-soft);
  }
  .cat:hover .cat-img { transform: scale(1.06); }

  .cat-n {
    position: absolute; top: 1rem; left: 1.1rem; z-index: 3;
    font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--color-paper); mix-blend-mode: difference;
  }

  /* Oscurecido inferior para que el cristal se asiente bien */
  .cat-scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to top, rgba(11, 11, 10, 0.55) 0%, rgba(11, 11, 10, 0.1) 34%, rgba(11, 11, 10, 0) 55%);
  }

  /* Panel de cristal con el texto superpuesto */
  .cat-glass {
    position: absolute; z-index: 2;
    left: 0.7rem; right: 0.7rem; bottom: 0.7rem;
    padding: 1.05rem 1.1rem 1.15rem;
    border-radius: 13px;
    /* Glass simulado sin backdrop-filter (rendimiento en Windows) */
    background: rgba(16, 15, 12, 0.6);
    border: 1px solid rgba(244, 244, 242, 0.16);
  }
  .cat-name { font-size: clamp(1.1rem, 1.4vw, 1.32rem); line-height: 1.2; color: var(--color-paper); }
  .cat-desc {
    margin-top: 0.5rem;
    font-size: 0.92rem; line-height: 1.45; color: rgba(244, 244, 242, 0.78);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .cat-link {
    display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.9rem;
    font-size: 0.76rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-paper);
  }
  .cat-link svg { width: 14px; height: 14px; transition: transform 0.4s var(--ease-soft); }
  .cat:hover .cat-link svg { transform: translateX(5px); }

  @media (max-width: 560px) { .cats-grid { grid-template-columns: 1fr; } .cat { aspect-ratio: 3 / 2; } }

  @media (prefers-reduced-motion: reduce) {
    .cat, .cat:hover, .cat-img, .cat:hover .cat-img { transition: none; transform: none; }
  }
</style>
