---
import { Image } from 'astro:assets';
import img from '../../assets/hero/primera-seccion.png';
---

<section class="autor">
  <div class="autor-media">
    <Image
      src={img}
      alt="Interior contemporáneo con paredes de cal natural y suelo de microcemento"
      widths={[1200, 1800, 2400, 3000]}
      sizes="100vw"
      quality={88}
      loading="eager"
      class="autor-img"
    />
    <!-- Sombreado para que el texto se lea siempre sobre la foto -->
    <div class="autor-scrim"></div>
  </div>

  <div class="container-mtm autor-inner">
    <div class="autor-text reveal">
      <span class="label label--tick">MTM · Materiales Modernos</span>
      <h2 class="autor-h">
        Soluciones pensadas para transformar espacios sin alma en espacios de autor.
      </h2>
      <a class="btn btn--light" href="/productos">
        Explorar catálogo
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .autor {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(480px, 82vh, 860px);
    padding-block: clamp(3rem, 6vw, 5rem);
    overflow: hidden;
    background: var(--color-carbon);
  }

  .autor-media { position: absolute; inset: 0; }
  .autor-img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Sombreado hacia la esquina inferior izquierda, donde se apoya el texto */
  .autor-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(11, 11, 10, 0.82) 0%, rgba(11, 11, 10, 0.34) 40%, rgba(11, 11, 10, 0) 68%),
      linear-gradient(to right, rgba(11, 11, 10, 0.7) 0%, rgba(11, 11, 10, 0.28) 42%, rgba(11, 11, 10, 0) 72%);
  }

  .autor-inner { position: relative; z-index: 2; width: 100%; }
  .autor-text { max-width: 56ch; color: var(--color-paper); }
  .autor-text .label { color: rgba(244, 244, 242, 0.82); }

  .autor-h {
    color: var(--color-paper);
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    line-height: 1.1;
    max-width: 30ch;
    margin: clamp(1.2rem, 2.5vw, 1.8rem) 0 clamp(1.8rem, 3.5vw, 2.4rem);
    text-wrap: balance;
  }

  /* Móvil: el degradado pasa a vertical y el texto se apoya abajo */
  @media (max-width: 780px) {
    .autor { min-height: 86svh; align-items: flex-end; }
    .autor-scrim {
      background: linear-gradient(
        to top,
        rgba(11, 11, 10, 0.9) 0%,
        rgba(11, 11, 10, 0.6) 45%,
        rgba(11, 11, 10, 0.25) 75%,
        rgba(11, 11, 10, 0.1) 100%
      );
    }
    .autor-text { max-width: none; }
  }
</style>
