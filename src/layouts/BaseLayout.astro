---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Ruta de imagen social (og:image), opcional */
  ogImage?: string;
  /** true en páginas con hero a pantalla completa: el header se superpone transparente */
  transparentHeader?: boolean;
  /** true en páginas de fondo oscuro: el header adopta la variante oscura */
  darkHeader?: boolean;
  /** Tipo Open Graph (website por defecto; "article" en posts del blog) */
  ogType?: string;
}

const {
  title,
  description = site.description,
  ogImage = '/og-default.jpg',
  transparentHeader = false,
  darkHeader = false,
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} · ${site.shortName}` : `${site.name} · Materiales premium`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const gaId = site.gaId;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="canonical" href={canonical} />

    <!-- Precarga de la tipografía crítica del hero (NATS) -->
    <link rel="preload" href="/fonts/NATS-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />

    <!-- Datos estructurados / metadatos específicos de cada página (JSON-LD) -->
    <slot name="head" />

    <!-- Si llegamos al inicio desde el logo, cubrimos de negro ANTES del primer
         pintado para que la transición sea continua (sin pantallazo ni corte). -->
    <script is:inline>
      try {
        if (
          sessionStorage.getItem('mtm-home-intro') &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.classList.add('hi-active');
        }
      } catch (e) {}
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <Header transparent={transparentHeader} dark={darkHeader} />
    <main id="main" class:list={['page-main', { 'has-hero': transparentHeader }]}>
      <slot />
    </main>
    <Footer />

    <!-- Barrido negro para la transición entre páginas -->
    <div class="page-sweep" data-sweep aria-hidden="true"></div>

    <!-- Aviso de cookies (solo aparece si hay Google Analytics configurado) -->
    <div class="cookie-banner" data-cookie-banner hidden aria-live="polite">
      <p class="cookie-txt">
        Usamos cookies analíticas (Google Analytics) para entender cómo se usa la web y mejorarla. Puedes
        aceptarlas o rechazarlas. Más información en la <a href="/politica-de-cookies">Política de cookies</a>.
      </p>
      <div class="cookie-btns">
        <button type="button" class="cookie-btn cookie-reject" data-cookie-reject>Rechazar</button>
        <button type="button" class="cookie-btn cookie-accept" data-cookie-accept>Aceptar</button>
      </div>
    </div>

    <script is:inline define:vars={{ gaId }}>
      (function () {
        var banner = document.querySelector('[data-cookie-banner]');
        function getConsent() { var m = document.cookie.match(/(?:^|; )mtm_consent=([^;]*)/); return m ? m[1] : null; }
        function setConsent(v) { document.cookie = 'mtm_consent=' + v + ';path=/;max-age=31536000;samesite=lax'; }
        function loadGA() {
          if (!gaId) return;
          var s = document.createElement('script');
          s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId, { anonymize_ip: true });
        }
        var consent = getConsent();
        if (consent === 'accepted') { loadGA(); }
        else if (gaId && !consent && banner) {
          banner.hidden = false;
          requestAnimationFrame(function () { banner.classList.add('is-in'); });
        }
        if (banner) {
          banner.querySelector('[data-cookie-accept]').addEventListener('click', function () {
            setConsent('accepted'); loadGA(); banner.classList.remove('is-in');
            setTimeout(function () { banner.hidden = true; }, 350);
          });
          banner.querySelector('[data-cookie-reject]').addEventListener('click', function () {
            setConsent('rejected'); banner.classList.remove('is-in');
            setTimeout(function () { banner.hidden = true; }, 350);
          });
        }
      })();
    </script>

    <!-- Revelado sutil al hacer scroll (respeta prefers-reduced-motion) -->
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>

    <!-- Scroll suave (Lenis) + transición de página (barrido negro lateral) -->
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ---- Scroll NATIVO (máxima fluidez en todas las plataformas, sobre todo con
      //      rueda de ratón en Windows). Sin librería de smooth-scroll que intercepte
      //      la rueda y provoque tirones. Solo compensamos el header fijo en las anclas. ----
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const id = a.getAttribute('href');
          if (!id || id.length < 2) return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          const y = (target as HTMLElement).getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({ top: y, behavior: reduce ? 'auto' : 'smooth' });
        });
      });

      // ---- Transición de página: barrido negro lateral rápido ----
      const sweep = document.querySelector<HTMLElement>('[data-sweep]');
      if (sweep && !reduce) {
        // Salida al cargar la nueva página (si venimos de un barrido)
        if (sessionStorage.getItem('mtm-sweep')) {
          sessionStorage.removeItem('mtm-sweep');
          sweep.classList.add('cover');
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              sweep.classList.remove('cover');
              sweep.classList.add('sweep-out');
            })
          );
          sweep.addEventListener('animationend', () => sweep.classList.remove('sweep-out'), { once: true });
        }

        // Entrada al pinchar cualquier enlace interno
        document.addEventListener(
          'click',
          (e) => {
            const a = (e.target as HTMLElement)?.closest?.('a');
            if (!a) return;
            if (a.hasAttribute('data-home-transition') || a.hasAttribute('data-no-sweep')) return;
            if (!a.getAttribute('href')) return;
            let url: URL;
            try {
              url = new URL(a.href, location.href);
            } catch {
              return;
            }
            if (url.origin !== location.origin) return;
            if (a.target === '_blank' || a.hasAttribute('download')) return;
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || (e as MouseEvent).button !== 0) return;
            if (url.pathname === location.pathname) return; // ancla en la misma página
            e.preventDefault();
            sessionStorage.setItem('mtm-sweep', '1');
            sweep.classList.add('sweep-in');
            let done = false;
            const go = () => {
              if (done) return;
              done = true;
              location.href = url.href;
            };
            sweep.addEventListener('animationend', go, { once: true });
            window.setTimeout(go, 600);
          },
          true
        );
      }

      // ---- Volver atrás (bfcache) ----
      // Al pulsar "atrás", el navegador restaura la página congelada tal y como
      // estaba al salir: con el barrido negro cubriendo. Como no se recarga el
      // JS, hay que limpiarlo a mano o se queda la pantalla en negro.
      window.addEventListener('pageshow', (e) => {
        if (!(e as PageTransitionEvent).persisted) return;
        sweep?.classList.remove('sweep-in', 'cover', 'sweep-out');
      });
    </script>

    <style>
      /* El header es fijo; las páginas sin hero necesitan compensar su altura */
      .page-main:not(.has-hero) { padding-top: 76px; }
      @media (max-width: 880px) {
        .page-main:not(.has-hero) { padding-top: 60px; }
      }
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        z-index: 100;
        background: var(--color-ink);
        color: var(--color-paper);
        padding: 0.75rem 1.25rem;
        font-size: 0.92rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .skip-link:focus {
        left: 0;
      }

      /* Aviso de cookies */
      .cookie-banner {
        position: fixed; left: 50%; bottom: clamp(1rem, 3vw, 1.6rem); z-index: 200;
        transform: translateX(-50%) translateY(130%); opacity: 0;
        width: min(680px, calc(100% - 2rem));
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.4rem;
        padding: 1.1rem 1.3rem; border-radius: 16px;
        background: var(--color-ink); color: var(--color-paper);
        box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.6);
        transition: transform 0.4s var(--ease-soft), opacity 0.4s var(--ease-soft);
      }
      .cookie-banner.is-in { transform: translateX(-50%) translateY(0); opacity: 1; }
      .cookie-txt { flex: 1 1 300px; margin: 0; font-size: 0.9rem; line-height: 1.5; color: rgba(244, 244, 242, 0.86); }
      .cookie-txt a { color: var(--color-paper); text-decoration: underline; text-underline-offset: 3px; }
      .cookie-btns { display: flex; gap: 0.6rem; flex: 0 0 auto; }
      .cookie-btn {
        font-family: var(--font-sans); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase;
        padding: 0.62rem 1.15rem; border-radius: 10px; cursor: pointer; border: 1px solid transparent;
        transition: background 0.2s var(--ease-soft), color 0.2s var(--ease-soft), border-color 0.2s var(--ease-soft);
      }
      .cookie-reject { background: transparent; color: rgba(244, 244, 242, 0.8); border-color: rgba(244, 244, 242, 0.3); }
      .cookie-reject:hover { color: var(--color-paper); border-color: var(--color-paper); }
      .cookie-accept { background: var(--color-paper); color: var(--color-ink); }
      .cookie-accept:hover { background: #fff; }
      @media (max-width: 520px) {
        .cookie-banner { flex-direction: column; align-items: stretch; }
        .cookie-btns { justify-content: stretch; }
        .cookie-btn { flex: 1; text-align: center; }
      }
    </style>
  </body>
</html>
