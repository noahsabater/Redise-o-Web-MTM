---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import { Image } from 'astro:assets';
import imgNave from '../assets/nosotros/nosotros-2.webp';
import imgEquipo from '../assets/nosotros/nosotros-1.webp';

// La nave: abre la pagina con la fachada.
const nave = {
  num: '01',
  kicker: 'La nave',
  title: 'Donde nace cada producto',
  text: 'Más de 30 años fabricando en España. Bienvenido a MTM — Materiales Modernos.',
};

// Los tres pilares, en rejilla.
const pilares = [
  { num: '02', kicker: 'Fabricación',        title: 'Materiales que resuelven', text: 'Pinturas aislantes, morteros de cal natural, epoxi 3D y revestimientos de fibras naturales, desarrollados aquí con obsesión por el detalle.' },
  { num: '03', kicker: 'Innovación',         title: 'Tecnología y tradición',   text: 'Combinamos la tecnología más innovadora con materiales nobles como la cal, para acabados sanos, transpirables y atemporales.' },
  { num: '04', kicker: 'Control de calidad', title: 'Nada sale sin revisarse',  text: 'Cada lote pasa un control exhaustivo para garantizar el mismo resultado, una y otra vez.' },
];

// El equipo: cierra con la banda de la jornada de demostracion.
const equipo = {
  num: '05',
  kicker: 'El equipo',
  title: 'Una empresa familiar',
  text: 'Detrás de cada bote hay un equipo que cuida lo que hace. Ese es el compromiso de MTM.',
};

const stats = [
  { n: '+30', label: 'Años de experiencia' },
  { n: '3', label: 'Marcas propias y distribuidas' },
  { n: '+200', label: 'Productos en catálogo' },
  { n: '100%', label: 'Fabricación española' },
];
---

<BaseLayout
  title="Sobre MTM · Nosotros"
  description="MTM es una empresa familiar dedicada a la fabricación de pinturas de alta calidad con la tecnología más innovadora. Conoce nuestra nave, cómo fabricamos y el equipo que hay detrás."
  darkHeader
>
  <!-- ===== Intro ===== -->
  <section class="nos-intro">
    <span class="label label--tick nos-eyebrow">Sobre MTM</span>
    <h1 class="nos-title">Fabricamos <span class="serif-italic">con intención</span></h1>
    <p class="nos-lead">
      Una empresa familiar dedicada a la fabricación de pinturas de alta calidad con la
      tecnología más innovadora. Baja y conócenos.
    </p>
    <span class="nos-scroll" aria-hidden="true">
      Desliza para conocernos
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
    </span>
  </section>

  <!-- ===== La nave ===== -->
  <section class="nband nband--tall">
    <div class="nband-media">
      <Image
        src={imgNave}
        alt="Fachada de la nave de MTM — Materiales Modernos, en Churra (Murcia)"
        widths={[600, 900]}
        sizes="100vw"
        quality={88}
        loading="eager"
        class="nband-img"
      />
      <div class="nband-scrim"></div>
    </div>

    <div class="nband-inner container-mtm">
      <div class="nband-content reveal">
        <span class="nband-eyebrow">{nave.num} · {nave.kicker}</span>
        <h2 class="nband-title">{nave.title}</h2>
        <p class="nband-text">{nave.text}</p>
      </div>
    </div>
  </section>

  <!-- ===== Los pilares ===== -->
  <section class="nos-pilares">
    <div class="container-mtm">
      <div class="pilares-grid">
        {pilares.map((p) => (
          <article class="pilar reveal">
            <span class="pilar-num">{p.num}</span>
            <span class="pilar-kicker">{p.kicker}</span>
            <h3 class="pilar-title">{p.title}</h3>
            <p class="pilar-text">{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== El equipo ===== -->
  <section class="nband nband--right">
    <div class="nband-media">
      <Image
        src={imgEquipo}
        alt="Equipo de MTM atendiendo a profesionales en una jornada de demostración de producto"
        widths={[600, 900]}
        sizes="100vw"
        quality={88}
        loading="lazy"
        class="nband-img"
      />
      <div class="nband-scrim"></div>
    </div>

    <div class="nband-inner container-mtm">
      <div class="nband-content reveal">
        <span class="nband-eyebrow">{equipo.num} · {equipo.kicker}</span>
        <h2 class="nband-title">{equipo.title}</h2>
        <p class="nband-text">{equipo.text}</p>
      </div>
    </div>
  </section>

  <!-- ===== Datos ===== -->
  <section class="nos-stats">
    <div class="container-mtm stats-grid">
      {stats.map((s) => (
        <div class="stat reveal">
          <span class="stat-n">{s.n}</span>
          <span class="stat-l">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== Cita ===== -->
  <section class="nos-quote">
    <div class="container-mtm">
      <blockquote class="quote reveal">
        <p class="quote-mark serif-italic">“</p>
        <p class="quote-text">
          Nuestra apuesta por la innovación es innegociable. Trabajamos día a día para
          desarrollar productos que den solución a problemas específicos del sector de la
          pintura, reformas y decoración.
        </p>
        <footer class="quote-by">
          <span class="quote-name">Rubén Sabater</span>
          <span class="quote-role">CEO · MTM Materiales Modernos</span>
        </footer>
      </blockquote>
    </div>
  </section>

  <Newsletter />
</BaseLayout>

<style>
  /* La página entera en oscuro */
  :global(body:has(.nos-intro)) { background: var(--color-carbon); }

  /* ===== Intro ===== */
  .nos-intro {
    background: var(--color-carbon);
    color: var(--color-paper);
    min-height: 92vh;
    display: flex; flex-direction: column; justify-content: center;
    padding: clamp(6rem, 12vw, 9rem) clamp(1.25rem, 5vw, 5rem) clamp(3rem, 6vw, 5rem);
    max-width: 92rem; margin-inline: auto;
  }
  .nos-eyebrow { color: rgba(244,244,242,0.7); margin-bottom: 1.6rem; }
  .nos-title {
    color: var(--color-paper);
    font-size: clamp(2.8rem, 9vw, 7rem); line-height: 0.98; letter-spacing: -0.01em;
    margin-bottom: 1.8rem; max-width: 16ch;
  }
  .nos-lead { color: rgba(244,244,242,0.78); font-size: clamp(1.1rem, 1.6vw, 1.4rem); line-height: 1.6; max-width: 46ch; }
  .nos-scroll {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: inline-flex; align-items: center; gap: 0.7rem;
    font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(244,244,242,0.6);
  }
  .nos-scroll svg { width: 18px; height: 18px; animation: bob 1.8s var(--ease-soft) infinite; }
  @keyframes bob { 0%,100%{ transform: translateY(0); } 50%{ transform: translateY(5px); } }

  /* ===== Bandas a sangre (la nave / el equipo) ===== */
  .nband {
    position: relative;
    min-height: clamp(440px, 68vh, 700px);
    display: flex; align-items: flex-end;
    padding-block: clamp(2.5rem, 7vh, 5rem);
    overflow: hidden;
    background: var(--color-carbon);
  }
  .nband--tall { min-height: clamp(520px, 82vh, 860px); }
  .nband-media { position: absolute; inset: 0; }
  .nband-img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease-soft); }
  .nband:hover .nband-img { transform: scale(1.04); }
  /* Doble degradado: desde abajo para el texto, lateral para separarlo de la foto */
  .nband-scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(11,11,10,0.94) 0%, rgba(11,11,10,0.6) 34%, rgba(11,11,10,0.1) 68%, rgba(11,11,10,0) 100%),
      linear-gradient(to right, rgba(11,11,10,0.9) 0%, rgba(11,11,10,0.58) 30%, rgba(11,11,10,0.14) 62%, rgba(11,11,10,0) 86%);
  }
  .nband--right .nband-scrim {
    background:
      linear-gradient(to top, rgba(11,11,10,0.94) 0%, rgba(11,11,10,0.6) 34%, rgba(11,11,10,0.1) 68%, rgba(11,11,10,0) 100%),
      linear-gradient(to left, rgba(11,11,10,0.9) 0%, rgba(11,11,10,0.58) 30%, rgba(11,11,10,0.14) 62%, rgba(11,11,10,0) 86%);
  }
  .nband-inner { position: relative; z-index: 2; width: 100%; }
  .nband-content { max-width: 48ch; color: var(--color-paper); }
  .nband--right .nband-content { margin-left: auto; text-align: right; }
  .nband-eyebrow {
    display: inline-block;
    font-size: 0.8rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(244,244,242,0.75); margin-bottom: 1.1rem;
  }
  .nband-title {
    color: var(--color-paper);
    font-size: clamp(2rem, 5vw, 3.8rem); line-height: 1.02;
    letter-spacing: -0.01em; margin-bottom: 1.1rem;
  }
  .nband-text { color: rgba(244,244,242,0.88); font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.6; }

  /* ===== Pilares ===== */
  .nos-pilares {
    background: var(--color-carbon); color: var(--color-paper);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    border-top: 1px solid rgba(244,244,242,0.1);
  }
  .pilares-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(2rem, 4vw, 3.5rem); }
  .pilar { border-top: 1px solid rgba(244,244,242,0.18); padding-top: 1.5rem; }
  .pilar-num {
    display: block; font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1;
    color: rgba(244,244,242,0.35); margin-bottom: 0.9rem;
  }
  .pilar-kicker {
    display: block; font-size: 0.78rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: rgba(244,244,242,0.62); margin-bottom: 0.7rem;
  }
  .pilar-title { color: var(--color-paper); font-size: clamp(1.35rem, 2.2vw, 1.9rem); line-height: 1.12; margin-bottom: 0.8rem; }
  .pilar-text { color: rgba(244,244,242,0.8); font-size: 1rem; line-height: 1.6; }

  /* ===== Datos ===== */
  .nos-stats { background: var(--color-carbon); color: var(--color-paper); padding-block: clamp(3.5rem, 8vw, 6rem); border-top: 1px solid rgba(244,244,242,0.1); }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .stat { display: flex; flex-direction: column; gap: 0.5rem; }
  .stat-n { color: var(--color-paper); font-family: var(--font-display); font-size: clamp(2.6rem, 5vw, 4rem); line-height: 1; letter-spacing: -0.01em; }
  .stat-l { font-size: 0.897rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(244,244,242,0.6); }

  /* ===== Cita ===== */
  .nos-quote { background: var(--color-carbon); color: var(--color-paper); padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 9vw, 7rem); }
  .quote { margin: 0; max-width: 60rem; }
  .quote-mark { font-size: 4rem; line-height: 0.4; color: rgba(244,244,242,0.4); display: block; }
  .quote-text { color: var(--color-paper); font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.6rem); line-height: 1.3; margin: 1.4rem 0 2rem; }
  .quote-by { display: flex; flex-direction: column; gap: 0.2rem; }
  .quote-name { color: var(--color-paper); font-size: 1.15rem; }
  .quote-role { font-size: 0.851rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(244,244,242,0.6); }

  /* ===== Responsive ===== */
  @media (max-width: 880px) {
    .pilares-grid { grid-template-columns: 1fr; gap: 2.2rem; }
    /* En movil el texto ocupa el ancho: el degradado pasa a ser solo vertical */
    .nband-content { max-width: none; }
    .nband--right .nband-content { margin-left: 0; text-align: left; }
    .nband-scrim,
    .nband--right .nband-scrim {
      background: linear-gradient(to top, rgba(11,11,10,0.95) 0%, rgba(11,11,10,0.65) 40%, rgba(11,11,10,0.15) 75%, rgba(11,11,10,0) 100%);
    }
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nos-scroll svg { animation: none; }
    .nband-img, .nband:hover .nband-img { transition: none; transform: none; }
  }
</style>
