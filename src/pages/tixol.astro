---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandShowcase from '../components/sections/BrandShowcase.astro';
import { brandBySlug } from '../data/brands';
import hero from '../assets/marcas/tixol-hero.jpg';
import gallery from '../assets/marcas/tixol-gallery.jpg';

const brand = brandBySlug('tixol')!;
---

<BaseLayout title="Tixol · Pinturas y revestimientos" description={brand.tagline} transparentHeader={true} darkHeader={true}>
  <BrandShowcase brand={brand} hero={hero} gallery={gallery} origin="Marca española" />
</BaseLayout>
