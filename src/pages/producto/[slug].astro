---
import BaseLayout from '../../layouts/BaseLayout.astro';
import products from '../../data/products.json';
import ampliadas from '../../data/fichas-ampliadas.json';
import { site } from '../../data/site';

// Contenido ampliado a mano a partir de la ficha técnica (fichas-ampliadas.json)
type Ampliada = { intro: string; usos: string[]; pasos: string[]; datos: [string, string][]; faq: { q: string; a: string }[] };

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const datasheet = (product as any).datasheet as string | undefined;
const extra = (ampliadas as Record<string, Ampliada>)[product.slug];
const related = products
  .filter((p) => p.slug !== product.slug && p.gamaMain && p.gamaMain === product.gamaMain)
  .slice(0, 4);
const brandHref = `/productos/${product.brand}/`;

// ---- SEO on-page ----
const gamaSlug = product.gamas.find((g) => g.name === product.gamaMain)?.slug;
const canonical = new URL(`/producto/${product.slug}`, site.url).href;

// Algunas fichas de Scalp solo traen "Disponible en N formatos" como entradilla:
// no sirve ni de resumen ni de descripción, así que se muestra como etiqueta.
const formatos = product.short?.trim().match(/^Disponible en (\d+) formatos\.?$/)?.[1];
const lead = formatos ? (product as any).seoDesc : product.short;

// Meta description: la escrita a mano (seoDesc) si la hay; si no, short → 1ª
// frase de la descripción → nombre, sin viñetas y acortada a ~155
const rawDesc = (
  (product as any).seoDesc ||
  (!formatos && product.short) ||
  (Array.isArray(product.description) ? product.description[0] : product.description) ||
  product.name
).replace(/\s*•\s*/g, ' ').replace(/\s+/g, ' ').trim();
const metaDesc =
  rawDesc.length > 158 ? rawDesc.slice(0, 155).replace(/\s+\S*$/, '') + '…' : rawDesc;

// Título: el escrito a mano (seoTitle, dice qué es el producto) o el nombre,
// sin duplicar la marca si el nombre ya empieza por ella
const seoTitle = (product as any).seoTitle ?? (product.name.startsWith(product.brandName)
  ? product.name
  : `${product.name} · ${product.brandName}`);

// Nota: no emitimos datos estructurados de tipo "Product" porque Google exige
// offers/review/aggregateRating para validarlo, y la web no muestra precios ni
// reseñas. Mantenemos solo BreadcrumbList (válido y útil para las migas).
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Productos', item: new URL('/productos', site.url).href },
    { '@type': 'ListItem', position: 2, name: product.brandName, item: new URL(brandHref, site.url).href },
    ...(gamaSlug
      ? [{ '@type': 'ListItem', position: 3, name: product.gamaMain, item: new URL(`/productos/${product.brand}/${gamaSlug}`, site.url).href }]
      : []),
    { '@type': 'ListItem', position: gamaSlug ? 4 : 3, name: product.name, item: canonical },
  ],
};

// FAQPage: Google ya no muestra el desplegable salvo en webs oficiales/salud, pero
// es válido y ayuda a buscadores e IA a citar la respuesta exacta
const faqSchema = extra?.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: extra.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
---

<BaseLayout title={seoTitle} description={metaDesc} ogImage={product.image ?? undefined}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />}
  <div class="wrap">
    <!-- Migas -->
    <nav class="crumbs container-mtm" aria-label="Miga de pan">
      <a href="/productos/">Productos</a>
      <span>/</span>
      <a href={brandHref}>{product.brandName}</a>
      {product.gamaMain && (<><span>/</span><span class="crumb-cur">{product.gamaMain}</span></>)}
    </nav>

    <section class="detail container-mtm">
      <div class="detail-media">
        {product.image ? (
          <img src={product.image} alt={product.imageAlt} loading="eager" class="detail-img" />
        ) : (
          <div class="detail-noimg">{product.brandName}</div>
        )}
      </div>

      <div class="detail-info">
        <div class="tags">
          <a href={brandHref} class="tag tag--brand">{product.brandName}</a>
          {product.tone && <span class="tag">{product.tone}</span>}
          {formatos && <span class="tag">{formatos} formatos</span>}
        </div>
        <h1 class="detail-title">{product.name}</h1>
        {product.uso && <p class="detail-uso">{product.uso}</p>}
        {lead && <p class="detail-short">{lead}</p>}

        {product.gamas.length > 0 && (
          <div class="detail-cats">
            <span class="dc-k">Gama</span>
            <div class="dc-list">
              {product.gamas.map((g) => <a class="dc-pill" href={`/productos/${product.brand}/${g.slug}/`}>{g.name}</a>)}
            </div>
          </div>
        )}

        <div class="detail-cta">
          <a class="btn btn--ink" href="/contacto/">
            Solicitar información
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          {datasheet && (
            <a class="btn btn--ghost-ink" href={datasheet} target="_blank" rel="noopener" aria-label={`Ver ficha técnica de ${product.name} (PDF)`}>
              Ver ficha técnica (PDF)
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3v13M7 12l5 5 5-5M5 21h14"></path></svg>
            </a>
          )}
          <a class="btn btn--ghost-ink" href="/productos/">Volver al catálogo</a>
        </div>
      </div>
    </section>

    {extra ? (
      <section class="desc ext container-mtm">
        <h2 class="desc-h">Para qué sirve</h2>
        <p class="ext-intro">{extra.intro}</p>

        <div class="ext-cols">
          <div>
            <h2 class="ext-h">Dónde se usa</h2>
            <ul class="ext-list">{extra.usos.map((u) => <li>{u}</li>)}</ul>
          </div>
          <div>
            <h2 class="ext-h">Cómo se aplica</h2>
            <ol class="ext-steps">{extra.pasos.map((p) => <li>{p}</li>)}</ol>
          </div>
        </div>

        <h2 class="ext-h">Datos técnicos</h2>
        <dl class="ext-datos">
          {extra.datos.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
        {datasheet && (
          <p class="ext-nota">Resumen de la <a href={datasheet} target="_blank" rel="noopener">ficha técnica (PDF)</a>, donde están todos los datos, precauciones y seguridad.</p>
        )}

        <h2 class="ext-h">Preguntas frecuentes</h2>
        <div class="ext-faq">
          {extra.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    ) : product.description.length > 0 && (
      <section class="desc container-mtm">
        <h2 class="desc-h">Descripción</h2>
        <div class="desc-body">
          {product.description.map((para) =>
            para.startsWith('•') ? <p class="desc-li">{para}</p> : <p>{para}</p>
          )}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="related container-mtm">
        <div class="related-head">
          <span class="label label--tick">Misma gama</span>
          <h2 class="related-h">Productos relacionados</h2>
        </div>
        <div class="related-grid">
          {related.map((r) => (
            <a class="rcard" href={`/producto/${r.slug}/`}>
              <div class="rcard-media">
                {r.image && <img src={r.image} alt={r.imageAlt} loading="lazy" class="rcard-img" />}
              </div>
              <span class="rcard-brand">{r.brandName}</span>
              <span class="rcard-name">{r.name}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .wrap { padding-top: clamp(2rem, 6vw, 4rem); }
  .crumbs { display: flex; gap: 0.6rem; align-items: center; font-size: 0.828rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ash); margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .crumbs a { color: var(--color-slate); }
  .crumbs a:hover { color: var(--color-ink); }
  /* Siempre en una línea: si se partiera en dos con la fuente de reserva y en
     una con NATS, toda la ficha saltaría al cargar la fuente (CLS) */
  .crumbs { white-space: nowrap; min-width: 0; }
  .crumb-cur { color: var(--color-ink); min-width: 0; overflow: hidden; text-overflow: ellipsis; }

  .detail { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .detail-media { background: var(--color-surface); border: 1px solid var(--color-line); aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; overflow: hidden; position: sticky; top: 100px; }
  .detail-img { width: 100%; height: 100%; object-fit: contain; padding: clamp(1.5rem, 4vw, 3rem); }
  .detail-noimg { font-size: 1.61rem; color: var(--color-ash); letter-spacing: 0.1em; text-transform: uppercase; }

  .tags { display: flex; gap: 0.6rem; margin-bottom: 1.4rem; }
  .tag { font-size: 0.759rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-slate); border: 1px solid var(--color-line); padding: 0.4rem 0.8rem; border-radius: 999px; }
  .tag--brand { color: var(--color-paper); background: var(--color-ink); border-color: var(--color-ink); }
  .detail-title { font-size: clamp(2rem, 4.5vw, 3.2rem); line-height: 1.04; margin-bottom: 1.4rem; }
  .detail-title:has(+ .detail-uso) { margin-bottom: 0.9rem; }
  .detail-uso {
    display: inline-block; font-size: 0.759rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-slate); background: var(--color-surface); border: 1px solid var(--color-line);
    padding: 0.4rem 0.8rem; border-radius: 999px; margin-bottom: 1.4rem;
  }
  .detail-short { font-size: clamp(1.208rem, 1.6vw, 1.438rem); line-height: 1.6; color: var(--color-slate); margin-bottom: 2rem; }

  .detail-cats { padding-block: 1.6rem; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.9rem; }
  .dc-k { font-size: 0.759rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ash); }
  .dc-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .dc-pill { font-size: 0.977rem; color: var(--color-ink); background: var(--color-mist); padding: 0.4rem 0.8rem; border-radius: 6px; transition: background 0.2s var(--ease-soft), color 0.2s var(--ease-soft); }
  .dc-pill:hover { background: var(--color-ink); color: var(--color-paper); }
  .detail-cta { display: flex; flex-wrap: wrap; gap: 1rem; }

  .desc { margin-top: clamp(3rem, 7vw, 5.5rem); max-width: 62rem; }
  .desc-h { font-size: var(--text-title); margin-bottom: 1.4rem; }
  .desc-body { font-size: 1.208rem; line-height: 1.75; color: #2a2926; }
  .desc-body p { margin-bottom: 1.1rem; }
  .desc-li { padding-left: 0.4rem; }

  /* Contenido ampliado */
  .ext-intro { font-size: 1.208rem; line-height: 1.75; color: #2a2926; max-width: 52rem; }
  .ext-h { font-size: clamp(1.3rem, 2.2vw, 1.6rem); line-height: 1.2; margin: clamp(2.2rem, 4vw, 3rem) 0 1.1rem; }
  .ext-cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); }
  .ext-list, .ext-steps { font-size: 1.092rem; line-height: 1.65; color: #2a2926; padding-left: 1.2rem; }
  .ext-list { list-style: disc; }
  .ext-steps { list-style: decimal; }
  .ext-list li, .ext-steps li { margin-bottom: 0.6rem; padding-left: 0.3rem; }
  .ext-list li::marker, .ext-steps li::marker { color: var(--color-ash); }
  .ext-datos { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--color-line); }
  .ext-datos > div { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.9rem 1rem 0.9rem 0; border-bottom: 1px solid var(--color-line); }
  .ext-datos dt { font-size: 0.759rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ash); }
  .ext-datos dd { font-size: 1.035rem; color: var(--color-ink); }
  .ext-nota { margin-top: 1rem; font-size: 0.92rem; color: var(--color-slate); }
  .ext-nota a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }
  .ext-faq { border-top: 1px solid var(--color-line); }
  .ext-faq details { border-bottom: 1px solid var(--color-line); }
  .ext-faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; padding: 1.05rem 0; font-size: 1.15rem; color: var(--color-ink); }
  .ext-faq summary::-webkit-details-marker { display: none; }
  .ext-faq summary::after { content: '+'; color: var(--color-ash); font-size: 1.4rem; line-height: 1; transition: transform 0.25s var(--ease-soft); }
  .ext-faq details[open] summary::after { transform: rotate(45deg); }
  .ext-faq details p { padding: 0 0 1.2rem; font-size: 1.092rem; line-height: 1.7; color: #2a2926; max-width: 52rem; }

  .related { margin-top: clamp(3.5rem, 8vw, 6rem); padding-top: clamp(2.5rem, 5vw, 4rem); border-top: 1px solid var(--color-line); }
  .related-head { display: flex; flex-direction: column; gap: 0.9rem; margin-bottom: clamp(1.8rem, 3vw, 2.6rem); }
  .related-h { font-size: var(--text-title); }
  .related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 2vw, 1.6rem); }
  .rcard { display: flex; flex-direction: column; background: var(--color-surface); border: 1px solid var(--color-line); transition: transform 0.4s var(--ease-soft), box-shadow 0.4s var(--ease-soft); }
  .rcard:hover { transform: translateY(-3px); box-shadow: 0 16px 36px -22px rgba(11,11,10,0.4); }
  .rcard-media { aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .rcard-img { width: 100%; height: 100%; object-fit: contain; padding: 1.2rem; }
  .rcard-brand { font-size: 0.713rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ash); margin: 0 1rem; }
  .rcard-name { font-size: 1.092rem; line-height: 1.25; margin: 0.3rem 1rem 1.1rem; }

  @media (max-width: 880px) {
    .detail { grid-template-columns: 1fr; }
    .detail-media { position: relative; top: 0; aspect-ratio: 4 / 3; }
    .related-grid { grid-template-columns: repeat(2, 1fr); }
    .ext-cols, .ext-datos { grid-template-columns: 1fr; }
  }
</style>
