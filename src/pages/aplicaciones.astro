---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Catalogo from '../components/sections/Catalogo.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Carga automática de TODAS las imágenes de IMG/Aplicaciones (cualquier nombre).
// Añade nuevas fotos a esa carpeta y se integran solas en el collage.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../../IMG/Aplicaciones/*.{png,PNG,jpg,JPG,jpeg,JPEG,webp,WEBP}',
  { eager: true }
);

const shots = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b, 'es', { numeric: true }))
  .map(([path, mod]) => {
    const file = path.split('/').pop() ?? '';
    const raw = file.replace(/\.[^.]+$/, ''); // sin extensión
    // Solo mostramos rótulo si el nombre es un título real, no un genérico
    // tipo "Imagen 3" o "Imagen generada 1 (5)".
    const isGeneric = /^imagen(\s|$)/i.test(raw);
    const name = isGeneric
      ? ''
      : raw.replace(/[_-]+/g, ' ').replace(/\s+\d+$/, '').trim();
    const ar = mod.default.width / mod.default.height; // proporción
    return { src: mod.default, name, ar };
  });

// Layout justificado tipo revista: agrupa las fotos en filas cuya suma de
// proporciones llega a un objetivo; cada fila se estira al 100% del ancho, así
// no quedan huecos ni recortes y encaja con cualquier número de imágenes.
const TARGET = 2.7;
type Shot = (typeof shots)[number];
const rows: Shot[][] = [];
let current: Shot[] = [];
let sum = 0;
for (const s of shots) {
  current.push(s);
  sum += s.ar;
  if (sum >= TARGET) {
    rows.push(current);
    current = [];
    sum = 0;
  }
}
if (current.length) rows.push(current);

let index = 0;
---

<BaseLayout
  title="Aplicaciones · Espacios transformados"
  description="Aplicaciones reales de los materiales de MTM: cal natural, microcemento, Nature Floor y Oxitec en construcciones de alta gama."
  darkHeader
>
  <div class="dark">
    <PageHeader
      eyebrow="Aplicaciones"
      title="Espacios"
      accent="transformados"
      intro="De la teoría al acabado real. Nature, cales naturales, Oxitec y Nature Floor en arquitectura contemporánea de alta gama."
    />

    <section class="collage">
      {rows.map((row) => (
        <div class="row">
          {row.map((s) => {
            const i = index++;
            return (
              <figure class="shot" style={`flex-grow:${s.ar.toFixed(4)}`}>
                <Image
                  src={s.src}
                  alt={s.name}
                  widths={[700, 1100, 1600]}
                  sizes="(max-width: 640px) 100vw, 50vw"
                  quality={87}
                  loading={i < 3 ? 'eager' : 'lazy'}
                  class="shot-img"
                />
                {s.name && <figcaption class="shot-cap">{s.name}</figcaption>}
              </figure>
            );
          })}
        </div>
      ))}
    </section>
  </div>

  <Catalogo />
</BaseLayout>

<style>
  /* Página en oscuro: las fotos brillan sobre negro y enlaza con el
     bloque de catálogo y el footer, que ya son oscuros. */
  .dark {
    background: var(--color-carbon);
    color: var(--color-paper);
  }
  .dark :global(.ph-title) { color: var(--color-paper); }
  .dark :global(.ph-intro) { color: rgba(244, 244, 242, 0.82); }
  .dark :global(.label) { color: rgba(244, 244, 242, 0.72); }
  .dark :global(.hairline) { background-color: rgba(244, 244, 242, 0.16); }

  .collage { width: 100%; }

  /* Cada fila llena el 100% del ancho; las fotos comparten altura y se pegan
     sin separación (collage tipo revista justificado). */
  .row { display: flex; }
  .shot {
    position: relative;
    margin: 0;
    flex-grow: 1;      /* se sobreescribe inline con la proporción real */
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
  }
  .shot-img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 1.1s var(--ease-soft);
  }
  .shot:hover .shot-img { transform: scale(1.045); }

  /* Nombre del proyecto: discreto, solo al pasar el ratón */
  .shot-cap {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 2.4rem 1.4rem 1.2rem;
    line-height: 1.2;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-paper);
    background: linear-gradient(to top, rgba(11, 11, 10, 0.7), rgba(11, 11, 10, 0));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s var(--ease-soft), transform 0.4s var(--ease-soft);
    pointer-events: none;
  }
  .shot:hover .shot-cap { opacity: 1; transform: none; }

  /* Móvil: una sola columna, fotos a todo el ancho apiladas sin separación */
  @media (max-width: 640px) {
    .row { display: block; }
    .shot { width: 100%; }
    .shot-cap { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot-img, .shot:hover .shot-img { transition: none; transform: none; }
  }
</style>
