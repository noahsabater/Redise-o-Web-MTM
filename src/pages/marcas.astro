---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Catalogo from '../components/sections/Catalogo.astro';
import { Image } from 'astro:assets';
import { brands } from '../data/brands';
import products from '../data/products.json';
import type { ImageMetadata } from 'astro';

import imgTixol from '../assets/marcas/marca-tixol.png';
import imgScalp from '../assets/marcas/marca-scalp.png';
import imgSupertape from '../assets/marcas/marca-supertape.png';

const imgs: Record<string, ImageMetadata> = { tixol: imgTixol, scalp: imgScalp, supertape: imgSupertape };
const origin: Record<string, string> = { tixol: 'Marca española', scalp: 'Marca francesa', supertape: 'Marca española' };
const count = (slug: string) => products.filter((p) => p.brand === slug).length;
---

<BaseLayout
  title="Marcas · Tixol, Scalp y Supertape"
  description="Orgullosos de nuestras marcas: Tixol, Scalp y Supertape. Fabricación y distribución oficial de pinturas, limpiadores y sistemas de protección."
>
  <PageHeader
    eyebrow="Nuestras marcas"
    title="Orgullosos de nuestras marcas"
    intro="Tres marcas de referencia en pintura, protección y limpieza de superficies. Conoce la historia y el universo de cada una."
  />

  <div class="bands">
    {brands.map((b, i) => (
      <article class:list={['band', { 'band--right': i % 2 === 1 }]}>
        <div class="band-media">
          <Image src={imgs[b.slug]} alt={b.name} widths={[900, 1440, 1920]} sizes="100vw" class="band-img" loading={i === 0 ? 'eager' : 'lazy'} />
          <div class="band-scrim"></div>
        </div>

        <div class="band-inner container-mtm">
          <div class="band-content reveal">
            <span class="band-eyebrow">{origin[b.slug]} · {b.role}</span>
            <h2 class="band-name">{b.name}</h2>
            <p class="band-desc">{b.description}</p>

            <ul class="band-tags">
              {b.categories.slice(0, 4).map((c) => <li>{c}</li>)}
            </ul>

            <div class="band-cta">
              <a class="btn btn--light" href={`/${b.slug}`}>
                Descubrir {b.name}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </a>
              <a class="btn btn--ghost" href={`/productos/${b.slug}`}>Ver catálogo ({count(b.slug)})</a>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  <Catalogo />
</BaseLayout>

<style>
  .bands { display: flex; flex-direction: column; }
  .band {
    position: relative;
    min-height: clamp(460px, 74vh, 780px);
    display: flex;
    align-items: center;
    /* Margen interior: el contenido nunca toca los bordes de la imagen */
    padding-block: clamp(2.5rem, 7vh, 5.5rem);
    overflow: hidden;
    background: var(--color-carbon);
  }
  .band-media { position: absolute; inset: 0; }
  .band-img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease-soft); }
  .band:hover .band-img { transform: scale(1.045); }
  .band-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(to right, rgba(11,11,10,0.85) 0%, rgba(11,11,10,0.5) 40%, rgba(11,11,10,0.08) 72%, rgba(11,11,10,0) 100%);
  }
  .band--right .band-scrim {
    background: linear-gradient(to left, rgba(11,11,10,0.85) 0%, rgba(11,11,10,0.5) 40%, rgba(11,11,10,0.08) 72%, rgba(11,11,10,0) 100%);
  }

  .band-inner { position: relative; z-index: 2; width: 100%; }
  .band-content { max-width: 46ch; color: var(--color-paper); }
  .band--right .band-content { margin-left: auto; text-align: right; }

  .band-eyebrow {
    display: inline-block;
    font-size: 0.8rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(244,244,242,0.72); margin-bottom: 1.2rem;
  }
  .band-name {
    color: var(--color-paper);
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.95; letter-spacing: -0.01em;
    margin-bottom: 1.4rem;
  }
  .band-desc {
    color: rgba(244,244,242,0.86);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.6; margin-bottom: 1.8rem;
  }
  .band-tags {
    list-style: none; margin: 0 0 2rem; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
  }
  .band--right .band-tags { justify-content: flex-end; }
  .band-tags li {
    font-size: 0.78rem; letter-spacing: 0.04em;
    color: rgba(244,244,242,0.9);
    border: 1px solid rgba(244,244,242,0.3);
    border-radius: 999px; padding: 0.4rem 0.9rem;
  }
  .band-cta { display: flex; flex-wrap: wrap; gap: 1rem; }
  .band--right .band-cta { justify-content: flex-end; }

  @media (max-width: 760px) {
    .band { min-height: 78svh; }
    .band-scrim,
    .band--right .band-scrim {
      background: linear-gradient(to top, rgba(11,11,10,0.9) 0%, rgba(11,11,10,0.45) 55%, rgba(11,11,10,0.2) 100%);
    }
    .band-inner { align-self: flex-end; padding-bottom: clamp(2rem, 6vw, 3.5rem); }
    .band { align-items: flex-end; }
    .band--right .band-content { margin-left: 0; text-align: left; }
    .band--right .band-tags,
    .band--right .band-cta { justify-content: flex-start; }
  }
</style>
