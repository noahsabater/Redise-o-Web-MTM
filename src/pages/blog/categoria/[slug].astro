---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/layout/PageHeader.astro';
import Newsletter from '../../../components/sections/Newsletter.astro';
import ProductosDelArticulo from '../../../components/sections/ProductosDelArticulo.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { site } from '../../../data/site';
import { slugCategoria, descripcionDe } from '../../../lib/categorias';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const porCategoria = new Map<string, typeof posts>();
  for (const p of posts) {
    const lista = porCategoria.get(p.data.category) ?? [];
    lista.push(p);
    porCategoria.set(p.data.category, lista);
  }

  return (
    [...porCategoria.entries()]
      // Con un solo artículo la página no aporta nada y Google la trata como
      // contenido pobre; esas categorías se quedan sólo como filtro en /blog/.
      .filter(([, lista]) => lista.length >= 2)
      .map(([nombre, lista]) => ({
        params: { slug: slugCategoria(nombre) },
        props: {
          nombre,
          posts: lista.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
        },
      }))
  );
}

const { nombre, posts } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const descripcion = descripcionDe(nombre);
const url = new URL(`/blog/categoria/${slugCategoria(nombre)}/`, site.url).href;

// Los productos se buscan sobre el conjunto de la categoría, no sobre un
// artículo suelto: así la página enlaza a las fichas del tema que trata.
const textoCategoria = `${nombre} ${nombre} ${posts.map((p) => p.data.title).join(' ')} ${descripcion}`;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', site.url).href },
    { '@type': 'ListItem', position: 3, name: nombre, item: url },
  ],
};

const listaLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${nombre} · Blog de ${site.name}`,
  description: descripcion,
  url,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/blog/${p.id}/`, site.url).href,
      name: p.data.title,
    })),
  },
};
---

<BaseLayout title={`${nombre} · Blog`} description={descripcion}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(listaLd)} />

  <div class="blog-bg"></div>

  <PageHeader eyebrow="Blog" title={nombre} intro={descripcion} />

  <section class="section blog">
    <div class="container-mtm">
      <nav class="crumbs" aria-label="Ruta de navegación">
        <a href="/">Inicio</a><span aria-hidden="true">/</span>
        <a href="/blog/">Blog</a><span aria-hidden="true">/</span>
        <span class="crumb-current">{nombre}</span>
      </nav>

      <p class="cuenta">{posts.length} artículos en esta categoría</p>

      <div class="grid">
        {posts.map((post, i) => (
          <a
            class:list={['card reveal', { 'card--nocover': !post.data.cover }]}
            href={`/blog/${post.id}/`}
            style={`--reveal-delay: ${(i % 3) * 90}ms`}
          >
            {post.data.cover && (
              <div class="card-media">
                <Image src={post.data.cover} alt={post.data.title} widths={[420, 720]} sizes="(max-width: 880px) 100vw, 33vw" class="card-img" />
              </div>
            )}
            <div class="meta"><span class="date">{fmt(post.data.date)}</span></div>
            <h2 class="card-h">{post.data.title}</h2>
            <p class="card-ex">{post.data.excerpt}</p>
          </a>
        ))}
      </div>

      <a class="volver" href="/blog/">← Todas las categorías</a>
    </div>
  </section>

  <ProductosDelArticulo texto={textoCategoria} />

  <Newsletter />
</BaseLayout>

<style>
  .blog-bg {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(46rem 46rem at 14% 14%, rgba(190, 178, 160, 0.24), transparent 60%),
      radial-gradient(40rem 40rem at 86% 40%, rgba(150, 160, 170, 0.2), transparent 60%),
      radial-gradient(38rem 38rem at 50% 96%, rgba(190, 180, 168, 0.16), transparent 62%);
  }

  .crumbs { display: flex; gap: 0.55rem; align-items: center; font-size: 0.85rem; color: var(--color-ash); margin-bottom: 0.9rem; }
  .crumbs a { color: var(--color-slate); }
  .crumbs a:hover { color: var(--color-ink); }
  .crumb-current { color: var(--color-ink); }

  .cuenta { font-size: 0.9rem; color: var(--color-slate); margin-bottom: clamp(1.6rem, 3vw, 2.4rem); }

  .grid { display: grid; gap: clamp(1.4rem, 2.6vw, 2.2rem); grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }

  .card { display: flex; flex-direction: column; }
  .card-media { overflow: hidden; border-radius: 14px; margin-bottom: 1.1rem; aspect-ratio: 3 / 2; }
  .card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease-soft); }
  .card:hover .card-img { transform: scale(1.04); }
  .card--nocover { padding-top: 0.4rem; border-top: 1px solid var(--color-line); }

  .meta { display: flex; gap: 0.8rem; align-items: center; margin-bottom: 0.7rem; }
  .date { font-size: 0.8rem; color: var(--color-ash); }
  .card-h { font-size: clamp(1.2rem, 1.7vw, 1.4rem); line-height: 1.25; margin-bottom: 0.6rem; }
  .card-ex { font-size: 0.96rem; line-height: 1.62; color: var(--color-slate); }

  .volver {
    display: inline-block; margin-top: clamp(2.2rem, 4vw, 3.2rem);
    font-size: 0.88rem; color: var(--color-ink);
    border-bottom: 1px solid var(--color-line); padding-bottom: 0.2rem;
  }
  .volver:hover { border-color: var(--color-ink); }
</style>
