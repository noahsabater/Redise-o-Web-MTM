---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Newsletter from '../../components/sections/Newsletter.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const [lead, ...rest] = posts;

// Categorías para el filtro: con recuento, solo las que tienen ≥2 artículos
const counts = new Map<string, number>();
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
const cats = [...counts.entries()]
  .filter(([name, n]) => n >= 2 && name.toLowerCase() !== 'blog')
  .sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title="Blog · Ideas para tus proyectos"
  description="Consejos prácticos y tendencias de decoración y reformas para ayudarte a crear espacios con personalidad."
>
  <div class="blog-bg"></div>

  <PageHeader
    eyebrow="Diario"
    title="Ideas para tus"
    accent="proyectos"
    intro="Consejos prácticos y tendencias de decoración y reformas para ayudarte a crear espacios con personalidad."
  />

  <section class="section blog">
    <div class="container-mtm">
      <!-- Filtro por categorías -->
      <div class="cats-filter" data-cats-filter>
        <button class="cchip is-on" type="button" data-cat-value="">Todas <span>{posts.length}</span></button>
        {cats.map(([name, n]) => (
          <button class="cchip" type="button" data-cat-value={name}>{name} <span>{n}</span></button>
        ))}
      </div>

      {lead && (
        <a
          class:list={['lead reveal', { 'lead--nocover': !lead.data.cover }]}
          href={`/blog/${lead.id}`}
          data-lead
          data-cat={lead.data.category}
        >
          {lead.data.cover && (
            <div class="lead-media">
              <Image src={lead.data.cover} alt={lead.data.title} widths={[720, 1200, 1600]} sizes="(max-width: 900px) 100vw, 60vw" quality={86} class="lead-img" />
            </div>
          )}
          <div class="lead-body">
            <div class="meta"><span class="cat">{lead.data.category}</span><span class="date">{fmt(lead.data.date)}</span></div>
            <h2 class="lead-h">{lead.data.title}</h2>
            <p class="lead-ex">{lead.data.excerpt}</p>
            <span class="readmore">Leer artículo
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </span>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <div class="grid" data-grid>
          {rest.map((post, i) => (
            <a
              class:list={['card reveal', { 'card--nocover': !post.data.cover }]}
              href={`/blog/${post.id}`}
              data-cat={post.data.category}
              style={`--reveal-delay: ${(i % 3) * 90}ms`}
            >
              {post.data.cover && (
                <div class="card-media">
                  <Image src={post.data.cover} alt={post.data.title} widths={[420, 720]} sizes="(max-width: 880px) 100vw, 33vw" class="card-img" />
                </div>
              )}
              <div class="meta"><span class="cat">{post.data.category}</span><span class="date">{fmt(post.data.date)}</span></div>
              <h3 class="card-h">{post.data.title}</h3>
              <p class="card-ex">{post.data.excerpt}</p>
            </a>
          ))}
        </div>
      )}

      <p class="empty" data-empty hidden>No hay artículos en esta categoría.</p>
    </div>
  </section>

  <Newsletter />
</BaseLayout>

<style>
  /* Fondo decorativo difuminado: da el ambiente "glass" sin blur por tarjeta */
  .blog-bg {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(46rem 46rem at 14% 14%, rgba(190, 178, 160, 0.24), transparent 60%),
      radial-gradient(40rem 40rem at 86% 40%, rgba(150, 160, 170, 0.2), transparent 60%),
      radial-gradient(38rem 38rem at 50% 96%, rgba(190, 180, 168, 0.16), transparent 62%);
  }

  /* ===== Filtro de categorías ===== */
  .cats-filter {
    display: flex; flex-wrap: wrap; gap: 0.55rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .cchip {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-sans); font-size: 0.92rem; color: var(--color-slate); cursor: pointer;
    padding: 0.5rem 1rem; border: 1px solid var(--color-line); border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(10px) saturate(1.3);
    -webkit-backdrop-filter: blur(10px) saturate(1.3);
    transition: color 0.2s var(--ease-soft), background 0.2s var(--ease-soft), border-color 0.2s var(--ease-soft);
  }
  .cchip span { font-size: 0.72rem; color: var(--color-ash); }
  .cchip:hover { color: var(--color-ink); border-color: var(--color-ash); }
  .cchip.is-on { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .cchip.is-on span { color: rgba(244, 244, 242, 0.7); }

  .meta { display: flex; gap: 0.8rem; align-items: center; margin-bottom: 0.9rem; }
  .cat {
    font-size: 0.736rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ink);
    border: 1px solid var(--color-line); padding: 0.32rem 0.7rem; border-radius: 999px;
    background: rgba(255, 255, 255, 0.5);
  }
  .date { font-size: 0.851rem; color: var(--color-ash); }

  /* ===== Destacado: cristal real (una sola tarjeta, sin coste) ===== */
  .lead {
    display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: stretch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border-radius: 22px; overflow: hidden;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, 0.65);
    box-shadow: 0 24px 60px -34px rgba(11, 11, 10, 0.4);
    transition: box-shadow 0.5s var(--ease-soft), transform 0.5s var(--ease-soft);
  }
  .lead.hidden { display: none; }
  .lead:hover { transform: translateY(-4px); box-shadow: 0 34px 70px -34px rgba(11, 11, 10, 0.5); }
  .lead-media { overflow: hidden; }
  .lead-img { width: 100%; height: 100%; min-height: 260px; object-fit: cover; transition: transform 0.8s var(--ease-soft); }
  .lead:hover .lead-img { transform: scale(1.04); }
  .lead-body { padding: clamp(1.8rem, 3.5vw, 3rem); display: flex; flex-direction: column; justify-content: center; }
  .lead-h { font-size: clamp(1.8rem, 3.6vw, 2.8rem); line-height: 1.1; margin-bottom: 1rem; }
  .lead-ex { color: var(--color-slate); line-height: 1.6; max-width: 46ch; margin-bottom: 1.6rem; }
  .readmore { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.828rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .readmore svg { width: 15px; height: 15px; transition: transform 0.4s var(--ease-soft); }
  .lead:hover .readmore svg { transform: translateX(5px); }

  /* ===== Rejilla: cristal simulado (translúcido + sombra, sin backdrop por tarjeta) ===== */
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.4rem, 2.4vw, 2rem); }
  .card {
    display: flex; flex-direction: column;
    border-radius: 18px; overflow: hidden;
    background: rgba(255, 255, 255, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 14px 36px -26px rgba(11, 11, 10, 0.35);
    transition: box-shadow 0.45s var(--ease-soft), transform 0.45s var(--ease-soft);
  }
  .card.hidden { display: none; }
  .card:hover { transform: translateY(-5px); box-shadow: 0 28px 56px -30px rgba(11, 11, 10, 0.45); }
  .card-media { overflow: hidden; aspect-ratio: 3 / 2; }
  .card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease-soft); }
  .card:hover .card-img { transform: scale(1.05); }
  .lead--nocover { grid-template-columns: 1fr; }
  .lead--nocover .lead-body { padding-block: clamp(2.2rem, 4vw, 3.2rem); }
  .card--nocover { justify-content: flex-start; }
  .card > .meta { margin: 1.3rem 1.3rem 0.5rem; }
  .card--nocover .meta { margin-top: 1.6rem; }
  .card-h { font-size: 1.334rem; line-height: 1.22; margin: 0 1.3rem 0.6rem; }
  .card-ex { font-size: 1.035rem; color: var(--color-slate); line-height: 1.55; margin: 0 1.3rem 1.5rem; }

  .empty { text-align: center; color: var(--color-slate); padding: 3rem 0; }

  @media (max-width: 880px) {
    .lead { grid-template-columns: 1fr; }
    .grid { grid-template-columns: 1fr; gap: 1.4rem; }
  }
  @media (min-width: 881px) and (max-width: 1120px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-cats-filter]');
  const lead = document.querySelector<HTMLElement>('[data-lead]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  if (bar) {
    bar.querySelectorAll<HTMLButtonElement>('.cchip').forEach((chip) => {
      chip.addEventListener('click', () => {
        bar.querySelectorAll('.cchip').forEach((c) => c.classList.remove('is-on'));
        chip.classList.add('is-on');
        const value = chip.dataset.catValue || '';

        // El destacado solo se muestra en "Todas"
        if (lead) lead.classList.toggle('hidden', value !== '');

        let visible = 0;
        cards.forEach((card) => {
          const ok = !value || card.dataset.cat === value;
          card.classList.toggle('hidden', !ok);
          card.classList.add('is-visible'); // asegura visibilidad al filtrar
          if (ok) visible++;
        });
        if (empty) empty.hidden = value === '' || visible > 0;
      });
    });
  }
</script>
