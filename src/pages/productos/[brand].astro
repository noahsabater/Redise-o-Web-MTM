---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import products from '../../data/products.json';
import { catalog } from '../../data/catalog';
import ambTixol from '../../assets/marcas/portada-tixol.png';
import ambScalp from '../../assets/marcas/portada-scalp.png';
import ambSupertape from '../../assets/marcas/portada-supertape.png';

export function getStaticPaths() {
  return ['tixol', 'scalp', 'supertape'].map((slug) => ({
    params: { brand: slug },
    props: { brand: slug, items: products.filter((p) => p.brand === slug) },
  }));
}

const { brand, items } = Astro.props;
const meta: Record<string, { name: string }> = {
  tixol: { name: 'Tixol' },
  scalp: { name: 'Scalp' },
  supertape: { name: 'Supertape' },
};
const brandName = meta[brand].name;
const amb: Record<string, any> = { tixol: ambTixol, scalp: ambScalp, supertape: ambSupertape };
const ambImg = amb[brand];

// Imagen propia de cada categoría (src/assets/marcas/categorias/<slug>.jpg)
const catImgs = import.meta.glob('../../assets/marcas/categorias/*.jpg', { eager: true, import: 'default' });
const catImgBySlug: Record<string, any> = {};
for (const path in catImgs) {
  const s = path.split('/').pop()!.replace(/\.\w+$/, '');
  catImgBySlug[s] = catImgs[path];
}

const countBySlug = (slug: string) => items.filter((p) => p.gamas.some((x) => x.slug === slug)).length;

// Categorías (gamas) reales con recuento + subcategorías (del índice del catálogo) con producto
const allGamas = catalog.find((c) => c.slug === brand)?.gamas ?? [];
const gamas = allGamas
  .map((g) => ({
    ...g,
    count: countBySlug(g.slug),
    subs: (g.sub ?? [])
      .filter((s) => s.slug !== g.slug) // evita la subcategoría idéntica a la propia gama
      .map((s) => ({ ...s, count: countBySlug(s.slug) }))
      .filter((s) => s.count > 0),
  }))
  .filter((g) => g.count > 0);

// Panel "Todos los productos" + una por categoría (con sus subcategorías desplegables)
const panels = [
  { href: `/productos/${brand}/todo/`, eyebrow: 'Catálogo completo', name: 'Todos los productos', count: items.length, all: true, img: ambImg, subs: [] as { name: string; slug: string; count: number }[] },
  ...gamas.map((g, i) => ({
    href: `/productos/${brand}/${g.slug}/`,
    eyebrow: `N.º ${String(i + 1).padStart(2, '0')}`,
    name: g.name,
    count: g.count,
    all: false,
    img: catImgBySlug[g.slug] ?? ambImg,
    subs: g.subs,
  })),
];
---

<BaseLayout
  title={`Productos ${brandName} · Categorías`}
  description={`Explora el catálogo de ${brandName} por categorías.`}
  transparentHeader={true}
  darkHeader={true}
>
  <section class="cats">
    <div class="cats-top container-mtm">
      <a class="cats-back" href="/productos/">← Todas las marcas</a>
      <a class="btn btn--red cats-dl" href="/catalogo-mtm.pdf" download>
        Descargar catálogo (PDF)
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3v13M7 12l5 5 5-5M5 21h14"></path></svg>
      </a>
    </div>

    <div class="cgrid">
      {panels.map((p, i) => (
        <article class={`cpanel${p.all ? ' cpanel--all' : ''}${p.subs.length ? ' has-subs' : ''}`}>
          <a class="cpanel-cover" href={p.href} aria-label={`Ver ${p.name}`}>
            <div class="cpanel-media">
              <Image src={p.img} alt="" widths={[500, 800, 1100]} sizes="(max-width: 860px) 100vw, 33vw" class="cpanel-img" loading={i < 3 ? 'eager' : 'lazy'} />
            </div>
            <div class="cpanel-scrim"></div>
          </a>
          <div class="cpanel-inner">
            <span class="cpanel-eyebrow">{p.eyebrow}</span>
            <a class="cpanel-name-link" href={p.href}><h2 class="cpanel-name">{p.name}</h2></a>

            {p.subs.length > 0 && (
              <div class="cpanel-subs">
                <ul class="cpanel-subs-list">
                  {p.subs.map((s) => (
                    <li>
                      <a href={`/productos/${brand}/${s.slug}/`}>
                        <span class="sn">{s.name}</span>
                        <span class="sc">{s.count}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <a class="cpanel-cta" href={p.href}>
              {p.subs.length ? 'Ver toda la categoría' : `${p.count} productos`}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .cats { background: var(--color-carbon); min-height: 100svh; padding-bottom: clamp(2rem, 4vw, 3.5rem); }
  .cats-top {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding-top: calc(76px + clamp(1.2rem, 3vw, 2rem)); padding-bottom: clamp(1.2rem, 3vw, 2rem);
  }
  .cats-back { font-size: 0.828rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(244,244,242,0.7); }
  .cats-back:hover { color: var(--color-paper); }
  .cats-dl { padding: 0.72rem 1.25rem; font-size: 0.76rem; }
  .cats-dl svg { width: 15px; height: 15px; }
  @media (max-width: 560px) { .cats-dl { font-size: 0.7rem; padding: 0.6rem 0.9rem; } }

  .cgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: clamp(0.5rem, 1vw, 0.9rem);
    padding-inline: clamp(0.5rem, 1vw, 0.9rem);
    align-items: start;
  }

  .cpanel {
    position: relative;
    aspect-ratio: 3 / 4; min-height: 340px;
    display: flex; align-items: flex-end;
    color: var(--color-paper);
  }
  /* Enlace que cubre la imagen (lleva a la categoría completa) */
  .cpanel-cover { position: absolute; inset: 0; z-index: 1; display: block; }
  .cpanel-media { position: absolute; inset: 0; overflow: hidden; }
  .cpanel-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease-soft); }
  .cpanel-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(11,11,10,0.88) 0%, rgba(11,11,10,0.4) 45%, rgba(11,11,10,0.3) 100%);
    transition: background 0.5s var(--ease-soft);
  }
  .cpanel-inner {
    position: relative; z-index: 2; width: 100%;
    padding: clamp(1.4rem, 2.4vw, 2rem);
    display: flex; flex-direction: column; gap: 0.5rem;
    pointer-events: none; /* solo los enlaces internos capturan el clic */
  }
  .cpanel-inner a { pointer-events: auto; }
  .cpanel-eyebrow { font-size: 0.736rem; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(244,244,242,0.72); }
  .cpanel-name-link { color: var(--color-paper); }
  .cpanel-name { color: var(--color-paper); font-size: clamp(1.5rem, 2.4vw, 2.1rem); line-height: 1.08; }

  /* Desplegable de subcategorías al pasar el ratón */
  .cpanel-subs {
    display: grid; grid-template-rows: 0fr; opacity: 0;
    transition: grid-template-rows 0.45s var(--ease-soft), opacity 0.3s var(--ease-soft), margin 0.4s var(--ease-soft);
    margin-top: 0;
  }
  .cpanel-subs-list { overflow: hidden; min-height: 0; list-style: none; margin: 0; padding: 0; }
  .cpanel-subs-list a {
    display: flex; align-items: center; justify-content: space-between; gap: 0.7rem;
    padding: 0.42rem 0; font-size: 0.94rem; line-height: 1.2;
    color: rgba(244,244,242,0.82);
    border-top: 1px solid rgba(244,244,242,0.16);
    transition: color 0.2s var(--ease-soft), padding-left 0.2s var(--ease-soft);
  }
  .cpanel-subs-list li:last-child a { border-bottom: 1px solid rgba(244,244,242,0.16); }
  .cpanel-subs-list a:hover { color: var(--color-paper); padding-left: 0.3rem; }
  .cpanel-subs-list .sc { color: rgba(244,244,242,0.45); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  .cpanel:hover .cpanel-subs { grid-template-rows: 1fr; opacity: 1; margin-top: 0.4rem; }

  .cpanel-cta {
    display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 0.4rem;
    font-size: 0.82rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(244,244,242,0.85);
    opacity: 0; transform: translateY(8px);
    transition: opacity 0.4s var(--ease-soft), transform 0.4s var(--ease-soft);
  }
  .cpanel-cta svg { width: 16px; height: 16px; transition: transform 0.4s var(--ease-soft); }

  .cpanel:hover .cpanel-img { transform: scale(1.06); }
  .cpanel:hover .cpanel-scrim { background: linear-gradient(to top, rgba(11,11,10,0.92) 0%, rgba(11,11,10,0.55) 55%, rgba(11,11,10,0.4) 100%); }
  .cpanel:hover .cpanel-cta { opacity: 1; transform: none; }
  .cpanel:hover .cpanel-cta svg { transform: translateX(5px); }

  /* "Todos los productos" ocupa toda la fila y es más ancho/cinematográfico */
  .cpanel--all { grid-column: 1 / -1; aspect-ratio: auto; min-height: clamp(220px, 34vh, 320px); }

  @media (hover: none) {
    .cpanel-cta { opacity: 1; transform: none; }
  }
  @media (max-width: 560px) {
    .cgrid { grid-template-columns: 1fr; }
    .cpanel { aspect-ratio: 16 / 10; min-height: 240px; }
  }
</style>
