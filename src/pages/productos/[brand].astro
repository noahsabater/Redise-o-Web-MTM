---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import products from '../../data/products.json';
import { catalog } from '../../data/catalog';

export function getStaticPaths() {
  return ['tixol', 'scalp', 'supertape'].map((slug) => ({
    params: { brand: slug },
    props: { brand: slug, items: products.filter((p) => p.brand === slug) },
  }));
}

const { brand, items } = Astro.props;
const meta: Record<string, { name: string; tagline: string }> = {
  tixol: { name: 'Tixol', tagline: 'Pinturas, revestimientos y soluciones decorativas para interior y exterior.' },
  scalp: { name: 'Scalp', tagline: 'Limpieza, hidrofugado y protección de superficies.' },
  supertape: { name: 'Supertape', tagline: 'Cintas y sistemas de protección para reformas.' },
};
const brandName = meta[brand].name;

// Categorías (gamas) reales de la marca, con recuento e imagen representativa
const allGamas = catalog.find((c) => c.slug === brand)?.gamas ?? [];
const gamas = allGamas
  .map((g) => ({
    ...g,
    count: items.filter((p) => p.gamas.some((x) => x.slug === g.slug)).length,
    img: items.find((p) => p.gamas.some((x) => x.slug === g.slug) && p.image)?.image ?? null,
  }))
  .filter((g) => g.count > 0);
const allImg = items.find((p) => p.image)?.image ?? null;

const arrow =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
---

<BaseLayout title={`Productos ${brandName} · Categorías`} description={`Explora el catálogo de ${brandName} por categorías.`}>
  <PageHeader
    eyebrow={`Catálogo · ${brandName}`}
    title="Elige una"
    accent="categoría"
    intro={`Explora los productos de ${brandName} por categoría, o entra al catálogo completo.`}
  />

  <div class="catalog-bg"></div>

  <section class="cats container-mtm">
    <a class="back" href="/productos">← Todas las marcas</a>

    <div class="cgrid">
      <!-- Catálogo completo -->
      <a class="ccard ccard--all" href={`/productos/${brand}/todo`}>
        <div class="ccard-media">
          {allImg && <img src={allImg} alt="" class="ccard-img" loading="eager" />}
        </div>
        <div class="ccard-body">
          <span class="ccard-eyebrow">Catálogo completo</span>
          <h2 class="ccard-name">Todos los productos</h2>
          <span class="ccard-foot">
            <span class="ccard-count">{items.length} productos</span>
            <span class="ccard-arr" set:html={arrow}></span>
          </span>
        </div>
      </a>

      <!-- Categorías -->
      {gamas.map((g, i) => (
        <a class="ccard" href={`/productos/${brand}/${g.slug}`}>
          <div class="ccard-media">
            {g.img && <img src={g.img} alt="" class="ccard-img" loading="lazy" />}
          </div>
          <div class="ccard-body">
            <span class="ccard-eyebrow">N.º {String(i + 1).padStart(2, '0')}</span>
            <h2 class="ccard-name">{g.name}</h2>
            <span class="ccard-foot">
              <span class="ccard-count">{g.count} productos</span>
              <span class="ccard-arr" set:html={arrow}></span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .catalog-bg {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(42rem 42rem at 12% 18%, rgba(190, 178, 160, 0.22), transparent 60%),
      radial-gradient(38rem 38rem at 88% 42%, rgba(150, 160, 170, 0.18), transparent 60%);
  }
  .cats { padding-top: clamp(1rem, 2vw, 1.5rem); padding-bottom: clamp(4rem, 8vw, 7rem); }
  .back { display: inline-block; margin-bottom: clamp(1.5rem, 3vw, 2.4rem); font-size: 0.828rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-slate); }
  .back:hover { color: var(--color-ink); }

  .cgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: clamp(1rem, 1.8vw, 1.5rem);
  }

  .ccard {
    display: flex; flex-direction: column; overflow: hidden;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 14px 32px -20px rgba(11, 11, 10, 0.22);
    transition: transform 0.4s var(--ease-soft), box-shadow 0.4s var(--ease-soft);
  }
  .ccard:hover { transform: translateY(-6px); box-shadow: 0 30px 54px -26px rgba(11, 11, 10, 0.34); }

  .ccard-media {
    aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; overflow: hidden;
    background: linear-gradient(160deg, #ffffff, var(--color-mist));
  }
  .ccard-img { width: 100%; height: 100%; object-fit: contain; padding: 1.8rem; transition: transform 0.6s var(--ease-soft); }
  .ccard:hover .ccard-img { transform: scale(1.06); }

  .ccard-body {
    padding: 1.3rem 1.4rem 1.5rem; border-top: 1px solid var(--color-line);
    display: flex; flex-direction: column; gap: 0.5rem; flex: 1;
  }
  .ccard-eyebrow { font-size: 0.736rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-ash); }
  .ccard-name { font-size: clamp(1.3rem, 1.8vw, 1.6rem); line-height: 1.15; color: var(--color-ink); }
  .ccard-foot {
    margin-top: auto; padding-top: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    border-top: 1px solid var(--color-line);
  }
  .ccard-count { font-size: 0.85rem; color: var(--color-slate); }
  .ccard-arr {
    display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: 50%;
    border: 1px solid var(--color-line); color: var(--color-ink);
    transition: transform 0.4s var(--ease-soft), background 0.4s var(--ease-soft), color 0.4s var(--ease-soft);
  }
  .ccard-arr :global(svg) { width: 18px; height: 18px; }
  .ccard:hover .ccard-arr { background: var(--color-ink); color: var(--color-paper); transform: translateX(4px); }

  /* La tarjeta de "Todos los productos" destaca en oscuro */
  .ccard--all { background: var(--color-ink); border-color: var(--color-ink); }
  .ccard--all .ccard-media { background: linear-gradient(160deg, #1a1917, #0f0e0d); }
  .ccard--all .ccard-body { border-top-color: rgba(244, 244, 242, 0.14); }
  .ccard--all .ccard-eyebrow { color: rgba(244, 244, 242, 0.55); }
  .ccard--all .ccard-name { color: var(--color-paper); }
  .ccard--all .ccard-foot { border-top-color: rgba(244, 244, 242, 0.14); }
  .ccard--all .ccard-count { color: rgba(244, 244, 242, 0.7); }
  .ccard--all .ccard-arr { border-color: rgba(244, 244, 242, 0.3); color: var(--color-paper); }
  .ccard--all:hover .ccard-arr { background: var(--color-paper); color: var(--color-ink); }

  @media (max-width: 560px) {
    .cgrid { grid-template-columns: 1fr 1fr; gap: 0.8rem; }
    .ccard-body { padding: 1rem 1rem 1.1rem; }
    .ccard-img { padding: 1.1rem; }
  }
</style>
