---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { reps } from '../data/reps';
import { site } from '../data/site';
---

<BaseLayout
  title="Contacto"
  description="Ponte en contacto con el equipo de MTM Materiales Modernos a través del formulario, email o teléfono. Red de representantes por toda España."
>
  <PageHeader
    eyebrow="Contacto"
    title="Hablemos de tu"
    accent="proyecto"
    intro="Si necesitas información, puedes ponerte en contacto con nuestro equipo a través del formulario, por email o por teléfono."
  />

  <section class="section">
    <div class="container-mtm contact-grid">
      <!-- Datos + formulario -->
      <div class="c-form-col">
        <div class="c-direct reveal">
          <div class="c-item">
            <span class="c-k">Dirección</span>
            <span class="c-v">P.I. Torre Alcayna, C/ San Pancracio 2 y 4, 30110 · Murcia</span>
          </div>
          <div class="c-item">
            <span class="c-k">Teléfono</span>
            <a class="c-v" href="tel:+34968306060">+34 968 306 060</a>
          </div>
          <div class="c-item">
            <span class="c-k">Email</span>
            <a class="c-v" href="mailto:mtm@mtm-murcia.com">mtm@mtm-murcia.com</a>
          </div>
        </div>

        <form class="c-form reveal" id="contactForm" name="contacto" novalidate style="--reveal-delay: 120ms">
          <div class="c-row">
            <label class="field">
              <span>Nombre</span>
              <input type="text" name="nombre" autocomplete="name" required />
              <em class="field-err" data-error-for="nombre"></em>
            </label>
            <label class="field">
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required />
              <em class="field-err" data-error-for="email"></em>
            </label>
          </div>
          <div class="c-row">
            <label class="field">
              <span>Teléfono</span>
              <input type="tel" name="telefono" autocomplete="tel" />
            </label>
            <label class="field">
              <span>Asunto</span>
              <input type="text" name="asunto" />
            </label>
          </div>
          <label class="field">
            <span>Mensaje</span>
            <textarea name="mensaje" rows="5" required></textarea>
            <em class="field-err" data-error-for="mensaje"></em>
          </label>
          <label class="c-check">
            <input type="checkbox" name="privacy" required />
            <span>Al enviar este formulario, acepto la <a href="/politica-de-privacidad/">Política de Privacidad</a>.</span>
          </label>
          <em class="field-err" data-error-for="privacy"></em>

          <!-- Trampa antispam: invisible para las personas, los bots la rellenan. -->
          <div class="c-hp" aria-hidden="true">
            <label>No rellenes este campo
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <button class="btn btn--ink" type="submit">
            Enviar mensaje
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </button>
          <p class="c-status" id="formStatus" role="status" aria-live="polite"></p>
        </form>
      </div>

      <!-- Departamento técnico -->
      <aside class="c-tech reveal" style="--reveal-delay: 200ms">
        <span class="label label--tick">Departamento técnico</span>
        <p class="c-tech-lead">¿Consultas sobre producto o aplicación? Nuestro equipo técnico te ayuda.</p>
        <div class="c-item">
          <span class="c-k">Responsable</span>
          <span class="c-v">Carlos García Carrasco</span>
        </div>
        <div class="c-item">
          <span class="c-k">Teléfono</span>
          <a class="c-v" href="tel:+34611819441">611 819 441</a>
        </div>
        <div class="c-item">
          <span class="c-k">Email</span>
          <a class="c-v" href="mailto:tecnico@mtm-murcia.com">tecnico@mtm-murcia.com</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- Red comercial -->
  <section class="section reps-sec">
    <div class="container-mtm">
      <div class="reps-head reveal">
        <span class="label label--tick">Red comercial</span>
        <h2 class="reps-h">Representantes por zona</h2>
      </div>
      <div class="reps-table reveal">
        <div class="reps-row reps-thead">
          <span>Zona</span><span>Representante</span><span>Teléfono</span><span>Email</span>
        </div>
        {reps.map((r) => (
          <div class="reps-row">
            <span class="reps-region">{r.region}</span>
            <span>{r.name}</span>
            <a href={`tel:+34${r.phone.replace(/\s/g, '')}`}>{r.phone}</a>
            <a href={`mailto:${r.email}`} class="reps-email">{r.email}</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: 1.5fr 0.9fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }

  .c-direct { display: flex; flex-wrap: wrap; gap: 2rem 3rem; padding-bottom: 2.2rem; margin-bottom: 2.4rem; border-bottom: 1px solid var(--color-line); }
  .c-item { display: flex; flex-direction: column; gap: 0.35rem; }
  .c-k { font-size: 0.782rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ash); }
  .c-v { font-size: 1.15rem; color: var(--color-ink); }
  a.c-v:hover { text-decoration: underline; text-underline-offset: 3px; }

  .c-form { display: flex; flex-direction: column; gap: 1.2rem; }
  .c-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
  .field { display: flex; flex-direction: column; gap: 0.5rem; }
  .field span { font-size: 0.805rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-slate); }
  .field input, .field textarea {
    background: transparent; border: 0; border-bottom: 1px solid var(--color-line);
    padding: 0.7rem 0.1rem; font-family: var(--font-sans); font-size: 1.15rem; color: var(--color-ink);
    resize: vertical;
  }
  .field input:focus, .field textarea:focus { outline: none; border-bottom-color: var(--color-ink); }
  .c-check { display: flex; gap: 0.6rem; align-items: flex-start; font-size: 0.943rem; color: var(--color-slate); margin-top: 0.4rem; }
  .c-check input { margin-top: 0.2rem; accent-color: var(--color-ink); }
  .c-check a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }
  .c-form .btn { align-self: flex-start; margin-top: 0.6rem; }

  /* Formulario: errores, trampa antispam y mensaje de estado */
  .c-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .field-err {
    display: none; font-style: normal; font-size: 0.85rem; line-height: 1.4;
    color: var(--color-mtm-red); letter-spacing: 0.01em;
  }
  .field-err.is-on { display: block; }
  .field.has-error input, .field.has-error textarea { border-bottom-color: var(--color-mtm-red); }
  .c-status { margin-top: 0.2rem; font-size: 0.95rem; line-height: 1.55; color: var(--color-slate); }
  .c-status.is-ok { color: var(--color-ink); }
  .c-status.is-error { color: var(--color-mtm-red); }
  .c-status a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .c-form button[disabled] { opacity: 0.5; pointer-events: none; }

  .c-tech { background: var(--color-mist); padding: clamp(1.8rem, 3vw, 2.4rem); display: flex; flex-direction: column; gap: 1.3rem; }
  .c-tech-lead { color: var(--color-slate); line-height: 1.6; font-size: 1.092rem; }

  .reps-sec { background: var(--color-carbon); color: rgba(244,244,242,0.72); }
  .reps-head { display: flex; flex-direction: column; gap: 1rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .reps-head .label { color: rgba(244,244,242,0.7); }
  .reps-h { color: var(--color-paper); font-size: var(--text-display); line-height: var(--text-display--line-height); }
  .reps-table { display: flex; flex-direction: column; }
  .reps-row {
    display: grid; grid-template-columns: 1.1fr 1.3fr 0.9fr 1.7fr; gap: 1rem;
    padding: 1rem 0; border-top: 1px solid rgba(244,244,242,0.14); align-items: center;
    font-size: 1.058rem;
  }
  .reps-thead { color: rgba(244,244,242,0.45); font-size: 0.782rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .reps-region { color: var(--color-paper); }
  .reps-row a { color: rgba(244,244,242,0.72); }
  .reps-row a:hover { color: var(--color-paper); }
  .reps-email { overflow-wrap: anywhere; }

  @media (max-width: 880px) {
    .contact-grid { grid-template-columns: 1fr; }
    .c-row { grid-template-columns: 1fr; }
    .reps-row { grid-template-columns: 1fr 1fr; gap: 0.3rem 1rem; padding: 1.1rem 0; }
    .reps-thead { display: none; }
    .reps-region { grid-column: 1 / -1; font-size: 0.828rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-ash); }
    .reps-email { grid-column: 1 / -1; }
  }
</style>

<script>
  // Envio del formulario de contacto al flujo de n8n (AvantiFlow).
  const ENDPOINT = 'https://n8n.avantiflow.com/webhook/mtm-formulario-web';
  const EMAIL_FALLBACK = 'mtm@mtm-murcia.com';

  const form = document.getElementById('contactForm');
  const status = document.getElementById('formStatus');

  if (form && status) {
    const validadores = {
      nombre: (v) => (v.trim().length >= 2 ? '' : 'Escribe tu nombre.'),
      email: (v) => (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) ? '' : 'Introduce un email valido.'),
      mensaje: (v) => (v.trim().length >= 10 ? '' : 'Cuentanos un poco mas (minimo 10 caracteres).'),
      privacy: (_v, campo) => (campo.checked ? '' : 'Debes aceptar la politica de privacidad.'),
    };

    const marcarError = (campo, mensaje) => {
      const aviso = form.querySelector('[data-error-for="' + campo.name + '"]');
      const caja = campo.closest('.field');
      if (caja) caja.classList.toggle('has-error', Boolean(mensaje));
      if (aviso) {
        aviso.textContent = mensaje;
        aviso.classList.toggle('is-on', Boolean(mensaje));
      }
      return !mensaje;
    };

    const validar = (campo) => {
      const fn = validadores[campo.name];
      return fn ? marcarError(campo, fn(campo.value, campo)) : true;
    };

    const decir = (texto, clase) => {
      status.innerHTML = texto;
      status.className = 'c-status' + (clase ? ' ' + clase : '');
    };

    // UTMs y referrer: se guardan en la sesion para no perderlos al navegar.
    const guardarOrigen = () => {
      const params = new URLSearchParams(window.location.search);
      const origen = {};
      ['utm_source', 'utm_medium', 'utm_campaign'].forEach((k) => {
        const v = params.get(k);
        if (v) origen[k] = v;
      });
      if (document.referrer && !document.referrer.includes(window.location.host)) {
        origen.referrer = document.referrer;
      }
      if (Object.keys(origen).length) {
        try { sessionStorage.setItem('mtm_origen', JSON.stringify(origen)); } catch (e) {}
      }
    };

    const leerOrigen = () => {
      try { return JSON.parse(sessionStorage.getItem('mtm_origen') || '{}'); } catch (e) { return {}; }
    };

    guardarOrigen();

    form.querySelectorAll('input, textarea').forEach((campo) => {
      campo.addEventListener('blur', () => validar(campo));
      campo.addEventListener('input', () => {
        const caja = campo.closest('.field');
        if ((caja && caja.classList.contains('has-error')) || campo.name === 'privacy') validar(campo);
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const campos = Array.from(form.querySelectorAll('input, textarea')).filter((c) => validadores[c.name]);
      if (!campos.map(validar).every(Boolean)) {
        decir('Revisa los campos marcados antes de enviar.', 'is-error');
        const primero = form.querySelector('.field.has-error input, .field.has-error textarea');
        if (primero) primero.focus();
        return;
      }

      const datos = Object.fromEntries(new FormData(form).entries());
      // La trampa no viaja: si venia rellena, es un bot y cortamos sin avisarle.
      if (datos.website) {
        form.reset();
        decir('Gracias. Te responderemos en menos de 24 horas laborables.', 'is-ok');
        return;
      }
      delete datos.website;

      const payload = Object.assign({}, datos, leerOrigen(), {
        privacidad: form.privacy.checked,
        enviado_en: new Date().toISOString(),
        pagina: window.location.href,
      });

      const boton = form.querySelector('button[type="submit"]');
      if (boton) boton.disabled = true;
      decir('Enviando\u2026');

      try {
        const respuesta = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!respuesta.ok) throw new Error('HTTP ' + respuesta.status);
        form.reset();
        form.querySelectorAll('.field-err').forEach((el) => el.classList.remove('is-on'));
        form.querySelectorAll('.field').forEach((el) => el.classList.remove('has-error'));
        decir('Gracias. Hemos recibido tu mensaje y te responderemos en menos de 24 horas laborables.', 'is-ok');
        // Conversion: solo se registra si el usuario acepto cookies.
        // Sin datos personales, unicamente la pagina desde la que se envio.
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'generate_lead', { pagina: window.location.pathname });
        }
      } catch (error) {
        console.error('MTM - error al enviar el formulario:', error);
        decir(
          'No hemos podido enviar el mensaje. Escribenos a ' +
            '<a href="mailto:' + EMAIL_FALLBACK + '">' + EMAIL_FALLBACK + '</a> o llamanos al 968 306 060.',
          'is-error'
        );
      } finally {
        if (boton) boton.disabled = false;
      }
    });
  }
</script>
