---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import { Image } from 'astro:assets';
import aplicador from '../assets/formacion/aplicador.png';
import showroom1 from '../assets/formacion/showroom-1.png';
import showroom2 from '../assets/formacion/showroom-2.png';
import showroom3 from '../assets/formacion/showroom-3.png';
import showroom4 from '../assets/formacion/showroom-4.png';
import showroom5 from '../assets/formacion/showroom-5.png';

// Programas: la imagen manda y sangra hasta el borde; el texto acompaña.
const programs = [
  {
    tag: 'Eventos',
    title: 'Trending Sessions',
    body: 'Eventos exclusivos para decoradores, arquitectos e interioristas. Disfruta de una experiencia inspiradora, en un ambiente cómodo y moderno, mientras descubres las mejores soluciones para tus proyectos, así como las últimas tendencias en Revestimientos Naturales. Conoce nuestros productos de una manera única, con exposiciones visuales y muestras reales.',
    cta: 'Quiero asistir',
    image: showroom1,
  },
  {
    tag: 'Certificación',
    title: 'Aplicador Homologado Tixol',
    body: '¿Te apasionan los revestimientos decorativos y quieres llevar tu carrera al siguiente nivel? Conviértete en Aplicador Homologado Tixol.',
    list: [
      'Jornada completa de formación intensiva, teórico-práctica.',
      'Dirigido a grupos de entre 5 y 15 personas, en nuestras instalaciones o en las de tu empresa.',
      'Formación de 3 gamas por jornada. Opción Nature (Nature Floor, Wall y Arcilla) u Opción Deco (Oxitec, Cement Floor y Epoxi 3D).',
      'Acceso a una bolsa exclusiva de profesionales certificados.',
    ],
    cta: 'Quiero certificarme',
    image: aplicador,
  },
  {
    tag: 'Empresas',
    title: 'Formación Equipos Comerciales',
    body: 'Formamos a tu equipo comercial para que domine nuestras soluciones y las últimas tendencias en revestimientos naturales. Una experiencia práctica, con muestras reales y casos de uso, pensada para vender mejor y con más confianza.',
    cta: 'Quiero más formación',
    image: showroom2,
  },
];

const showroomShots = [showroom3, showroom4, showroom5];
---

<BaseLayout
  title="Formación · Fórmate con nosotros"
  description="Programas de formación técnica y certificaciones oficiales de Tixol. De la teoría a la práctica de alto rendimiento."
>
  <PageHeader
    eyebrow="Formación"
    title="Fórmate"
    accent="con nosotros"
    intro="Accede con MTM a programas de formación técnica y certificaciones oficiales de Tixol. De la teoría a la práctica de alto rendimiento."
  />

  <section class="programs">
    {programs.map((p, i) => (
      <article class:list={['prog', { 'prog--flip': i % 2 === 1 }]}>
        <div class="prog-media">
          <Image
            src={p.image}
            alt={p.title}
            widths={[700, 1100, 1600]}
            sizes="(max-width: 900px) 100vw, 58vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            class="prog-img"
          />
        </div>

        <div class="prog-text reveal">
          <span class="label label--tick">{p.tag}</span>
          <h2 class="prog-title">{p.title}</h2>
          <p class="prog-body">{p.body}</p>
          {p.list && (
            <ul class="prog-list">
              {p.list.map((li) => <li>{li}</li>)}
            </ul>
          )}
          <a class="btn btn--ghost-ink" href="/contacto">{p.cta}</a>
        </div>
      </article>
    ))}
  </section>

  <!-- Cierre inmersivo: el Showroom, en oscuro y a toda pantalla -->
  <section class="showroom">
    <div class="container-mtm sr-head reveal">
      <span class="sr-tag">Showroom</span>
      <h2 class="sr-title">Showroom MTM</h2>
      <p class="sr-body">
        Sabemos que elegir la decoración perfecta es una decisión importante. Por eso abrimos las
        puertas de nuestra casa para que te sientas en la tuya. En nuestro Showroom podrás recorrer
        espacios reales, descubrir cómo interactúa la luz con nuestros acabados y llevarte la
        seguridad de que lo que ves es exactamente lo que sueñas.
      </p>
      <a class="btn btn--light" href="/contacto">Muy pronto</a>
    </div>

    <div class="sr-gallery">
      {showroomShots.map((s, i) => (
        <figure class="sr-shot">
          <Image
            src={s}
            alt={`Showroom MTM ${i + 1}`}
            widths={[500, 800, 1100]}
            sizes="(max-width: 760px) 100vw, 32vw"
            loading="lazy"
            class="sr-img"
          />
        </figure>
      ))}
    </div>
  </section>

  <Newsletter />
</BaseLayout>

<style>
  /* ===== Programas: imagen protagonista sangrando al borde ===== */
  .programs { display: flex; flex-direction: column; }

  .prog {
    display: grid;
    grid-template-columns: 64% 36%;
    align-items: center;
  }
  .prog--flip { grid-template-columns: 36% 64%; }
  .prog--flip .prog-media { order: 2; }

  .prog-media { overflow: hidden; }
  .prog-img {
    width: 100%;
    height: clamp(420px, 62vh, 760px);
    object-fit: cover;
    display: block;
    transition: transform 1.3s var(--ease-soft);
  }
  .prog:hover .prog-img { transform: scale(1.04); }

  /* El texto monta ligeramente sobre la foto: profundidad editorial */
  .prog-text {
    position: relative;
    z-index: 2;
    background: var(--color-paper);
    padding: clamp(1.8rem, 3vw, 3rem);
    /* Monta sobre la foto por dentro y respeta el margen de página por fuera */
    margin-left: clamp(-5rem, -5vw, -2rem);
    margin-right: clamp(1.25rem, 4vw, 4rem);
  }
  .prog--flip .prog-text {
    margin-left: clamp(1.25rem, 4vw, 4rem);
    margin-right: clamp(-5rem, -5vw, -2rem);
  }

  .prog-title { font-size: var(--text-title); line-height: 1.12; margin: 1.1rem 0 1.1rem; }
  .prog-body { color: var(--color-slate); line-height: 1.7; margin-bottom: 1.4rem; }
  .prog-list { list-style: none; margin: 0 0 1.8rem; padding: 0; }
  .prog-list li {
    position: relative;
    padding: 0.75rem 0 0.75rem 1.5rem;
    border-top: 1px solid var(--color-line);
    font-size: 1.081rem; color: var(--color-slate); line-height: 1.5;
  }
  .prog-list li::before {
    content: ''; position: absolute; left: 0; top: 1.15rem;
    width: 8px; height: 1px; background: var(--color-ink);
  }
  .prog-list li:last-child { border-bottom: 1px solid var(--color-line); }

  /* ===== Showroom: cierre inmersivo en oscuro ===== */
  .showroom {
    background: var(--color-carbon);
    color: var(--color-paper);
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(3.5rem, 8vw, 6rem);
  }
  .sr-head { display: flex; flex-direction: column; align-items: flex-start; max-width: 60ch; }
  .sr-tag {
    font-size: 0.8rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(244, 244, 242, 0.72); margin-bottom: 1.2rem;
  }
  .sr-title {
    color: var(--color-paper);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1.02; margin-bottom: 1.4rem;
  }
  .sr-body {
    color: rgba(244, 244, 242, 0.84);
    line-height: 1.7; margin-bottom: 2rem;
  }

  /* Trío escalonado: composición viva, no una rejilla plana */
  .sr-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.6rem, 1.6vw, 1.4rem);
    align-items: start;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1rem, 4vw, 3rem) 0;
  }
  .sr-shot { margin: 0; overflow: hidden; }
  .sr-shot:nth-child(2) { margin-top: clamp(1.5rem, 5vw, 4rem); }
  .sr-shot:nth-child(3) { margin-top: clamp(0.8rem, 2.5vw, 2rem); }
  .sr-img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
    transition: transform 1.3s var(--ease-soft);
  }
  .sr-shot:hover .sr-img { transform: scale(1.05); }

  /* ===== Responsive ===== */
  @media (max-width: 900px) {
    .prog,
    .prog--flip { grid-template-columns: 1fr; }
    .prog--flip .prog-media { order: 0; }
    .prog-img { height: clamp(300px, 52vw, 460px); }
    .prog-text {
      margin-left: clamp(1rem, 5vw, 3rem);
      margin-right: clamp(1rem, 5vw, 3rem);
      margin-top: -2.5rem;
      max-width: none;
    }
    .prog--flip .prog-text {
      margin-left: clamp(1rem, 5vw, 3rem);
      margin-right: clamp(1rem, 5vw, 3rem);
    }
  }
  @media (max-width: 620px) {
    .sr-gallery { grid-template-columns: 1fr; }
    .sr-shot,
    .sr-shot:nth-child(2),
    .sr-shot:nth-child(3) { margin-top: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .prog-img, .prog:hover .prog-img,
    .sr-img, .sr-shot:hover .sr-img { transition: none; transform: none; }
  }
</style>
